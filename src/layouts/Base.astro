---
/**
 * Base — the single page shell. Head (Seo, favicons, font preload), skip
 * link, sticky header, main, footer, Ask DEFEX widget, and the shared motion
 * script (scroll progress, nav border, reveals, hero intro/parallax,
 * scroll-drawn lines).
 */
import '../styles/theme.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AskDefex from '../components/AskDefex.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  structuredData?: Record<string, unknown>;
  mainClass?: string;
}
const {
  title,
  description,
  ogImage,
  structuredData,
  mainClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1a1a2e" />

    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href="/favicon-dark.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />

    <link
      rel="preload"
      href="/fonts/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Seo
      title={title}
      description={description}
      ogImage={ogImage}
      structuredData={structuredData}
    />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div id="scroll-progress"></div>
    <SiteHeader />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <SiteFooter />
    <AskDefex />

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';

      const progress = document.getElementById('scroll-progress');
      const nav = document.getElementById('site-nav');
      const hero = document.querySelector<HTMLElement>('[data-hero]');
      const heroParallax = hero?.querySelector<HTMLElement>('[data-hero-parallax]') ?? null;

      function applyScroll() {
        const y = window.scrollY || 0;
        const doc = document.documentElement;
        const max = Math.max(1, doc.scrollHeight - window.innerHeight);
        if (progress) progress.style.width = (Math.min(1, y / max) * 100).toFixed(2) + '%';
        if (nav) {
          if (y > 8) nav.setAttribute('data-scrolled', '');
          else nav.removeAttribute('data-scrolled');
        }
        if (!reduce && hero && heroParallax) {
          const h = hero.offsetHeight || 1;
          const p = Math.min(1, y / h);
          heroParallax.style.transform = `translateY(${(p * 90).toFixed(1)}px)`;
        }
        document.querySelectorAll<HTMLElement>('[data-scroll-fill]').forEach((fill) => {
          const track = fill.closest<HTMLElement>('[data-scroll-track]');
          if (!track) return;
          const focalFraction = parseFloat(fill.dataset.focal || '0.72');
          const extra = parseFloat(fill.dataset.extra || '0');
          const mode = fill.dataset.mode === 'width' ? 'width' : 'height';
          const rect = track.getBoundingClientRect();
          const focal = window.innerHeight * focalFraction;
          const p = Math.max(0, Math.min(1, (focal - rect.top) / (rect.height + extra)));
          fill.style[mode] = (p * 100).toFixed(1) + '%';
        });
      }

      window.addEventListener('scroll', applyScroll, { passive: true });
      window.addEventListener('resize', applyScroll, { passive: true });
      applyScroll();

      // Reveals: fade + 24px slide-up, per-element stagger, fire once.
      const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (reduce || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              const delay = el.dataset.delay || '0';
              el.style.setProperty('--reveal-delay', `${delay}ms`);
              el.classList.add('is-revealed');
              obs.unobserve(el);
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // Hero intro: eyebrow -> H1 -> sub -> buttons, staggered on load.
      if (!reduce) {
        document.querySelectorAll<HTMLElement>('[data-hero-seq]').forEach((el) => {
          const i = parseInt(el.getAttribute('data-hero-seq') || '0', 10) || 0;
          el.animate(
            [
              { opacity: 0, transform: 'translateY(28px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            { duration: 750, delay: 150 + i * 140, easing: ease, fill: 'both' }
          );
        });
        const heroPhoto = document.querySelector<HTMLElement>('[data-hero-photo]');
        if (heroPhoto) {
          heroPhoto.animate(
            [{ transform: 'scale(1.06)' }, { transform: 'scale(1)' }],
            { duration: 6000, easing: ease, fill: 'both' }
          );
        }
      } else {
        document.querySelectorAll<HTMLElement>('[data-hero-seq]').forEach((el) => {
          el.style.opacity = '1';
        });
      }
    </script>
  </body>
</html>
