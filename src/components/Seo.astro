---
/**
 * Seo — per-page title/description, canonical, Open Graph + Twitter card.
 * Canonical + OG intentionally reference the future production domain even on
 * the preview (spec §9). All assets are same-origin; no third-party tags.
 */
interface Props {
  title: string;
  description: string;
  /** OG image basename in /og/, without extension. */
  ogImage?: string;
  /** Optional JSON-LD object (Home only per spec §9). */
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  ogImage = 'default',
  structuredData,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || Astro.site!.href;
const ogUrl = new URL(`/og/${ogImage}.png`, Astro.site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="DEFEX Engineering" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

{
  structuredData && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  )
}
