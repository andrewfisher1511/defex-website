---
/**
 * PageHeader — inner-page header. `navy` variant gets a faint blueprint grid
 * (+ optional mark watermark); `white` variant is plain canvas/white. Content
 * (eyebrow/H1/lede) staggers in on load via data-hero-seq (Base.astro).
 */
interface Props {
  variant?: 'navy' | 'white';
  watermark?: boolean;
  heading: string;
  eyebrow: string;
  headingSize?: number;
  lede?: string;
  border?: boolean;
  padBottom?: number;
  class?: string;
}
const {
  variant = 'white',
  watermark = false,
  heading,
  eyebrow,
  headingSize = 76,
  lede,
  border = false,
  padBottom = 88,
  class: className = '',
} = Astro.props;
---

<header
  class:list={['page-header', `is-${variant}`, { 'has-border': border }, className]}
  style={`--ph-pad-bottom:${padBottom}px; --ph-h1-size:${headingSize}px`}
>
  {variant === 'navy' && <div class="page-header__grid" aria-hidden="true"></div>}
  {
    watermark && (
      <img src="/brand/defex-mark-white.svg" alt="" aria-hidden="true" class="page-header__watermark" />
    )
  }
  <div class="page-header__inner">
    <div data-hero-seq="0" class="page-header__eyebrow">
      <span class="page-header__rule"></span>
      <span class="page-header__eyebrow-label">{eyebrow}</span>
    </div>
    <h1 data-hero-seq="1" class="page-header__heading">{heading}</h1>
    {lede && <p data-hero-seq="2" class="page-header__lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    position: relative;
    padding: 216px var(--site-gutter) var(--ph-pad-bottom);
    overflow: hidden;
  }
  .page-header.is-white {
    background: #fff;
  }
  .page-header.is-navy {
    background: var(--color-navy);
  }
  .page-header.has-border {
    border-bottom: 1px solid var(--color-border);
  }
  .page-header__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
  }
  .page-header__watermark {
    position: absolute;
    right: -60px;
    top: -80px;
    width: 420px;
    opacity: 0.05;
    pointer-events: none;
  }
  .page-header__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    position: relative;
  }
  .page-header__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }
  .page-header__rule {
    display: block;
    width: 48px;
    height: 2px;
    background: var(--color-blue);
    flex-shrink: 0;
  }
  .page-header__eyebrow-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.32em;
    white-space: nowrap;
  }
  .is-navy .page-header__eyebrow-label {
    color: var(--color-concrete, #c9cfd8);
  }
  .is-white .page-header__eyebrow-label {
    color: var(--color-steel);
  }
  .page-header__heading {
    margin: 0 0 28px;
    max-width: 1100px;
    font-size: var(--ph-h1-size);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .is-navy .page-header__heading {
    color: #fff;
  }
  .is-white .page-header__heading {
    color: var(--color-navy);
  }
  .page-header__lede {
    margin: 0;
    max-width: 640px;
    font-size: 18px;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .is-navy .page-header__lede {
    color: rgba(255, 255, 255, 0.78);
  }
  .is-white .page-header__lede {
    color: var(--color-ink-muted);
  }

  @media (max-width: 899px) {
    .page-header {
      padding-top: 128px;
    }
    .page-header__heading {
      font-size: clamp(40px, 11vw, var(--ph-h1-size));
    }
  }
</style>
