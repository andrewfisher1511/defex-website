---
/**
 * DefectDiagnostics — Home's navy interactive: 3-scenario carousel, each with
 * 3 photo pins (white DEFEX X mark — the one approved brand exception) that
 * swap a detail card. Client JS only toggles visibility/active state; no
 * framework, no client-side data fetch.
 */
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import Eyebrow from './Eyebrow.astro';
import { diagnostics } from '../lib/diagnostics.ts';
import { getProjectImage } from '../lib/images.ts';

const scenarios = diagnostics.scenarios;
const optimized = await Promise.all(
  scenarios.map((s) =>
    getImage({ src: getProjectImage(s.image), width: 960, format: 'webp' })
  )
);

function cardSide(x: number) {
  return x > 55 ? 'left: 24px' : 'right: 24px';
}
---

<section class="diag" data-reveal>
  <div class="diag__inner">
    <div class="diag__text">
      <Eyebrow tone="dark">DEFECT DIAGNOSTICS</Eyebrow>
      <h2 class="diag__heading">From symptom to cause.</h2>
      <p class="diag__body">
        Every defect is pinned where it sits — photographed at the point of observation, keyed to the
        relevant Australian Standards and NCC provisions, and traced back to cause before a fix is
        designed.
      </p>
      <p class="diag__prompt">SELECT A PIN TO INSPECT</p>
      <div class="diag__nav">
        <button type="button" data-diag-prev aria-label="Previous example" class="diag__nav-btn">
          <Icon name="chevron-left" size={18} />
        </button>
        <button type="button" data-diag-next aria-label="Next example" class="diag__nav-btn">
          <Icon name="chevron-right" size={18} />
        </button>
        <span data-diag-title class="diag__nav-title">{scenarios[0].title}</span>
        <span data-diag-counter class="diag__nav-counter">1 / {scenarios.length}</span>
      </div>
    </div>

    <div class="diag__panel" data-diag-panel>
      <img
        data-diag-photo
        src={optimized[0].src}
        alt="Building under inspection"
        width="960"
        height="560"
        class="diag__photo"
      />
      <div class="diag__photo-overlay" aria-hidden="true"></div>

      {
        scenarios.map((scn, si) => (
          <div class="diag__pinset" data-pinset={si} hidden={si !== 0}>
            {scn.pins.map((pin, pi) => (
              <button
                type="button"
                class="diag__pin"
                data-pin={pi}
                data-active={pi === 0 ? '' : undefined}
                style={`left:${pin.x}%; top:${pin.y}%`}
                aria-label={pin.title}
              >
                <img src="/brand/defex-mark-white.svg" alt="" class="diag__pin-mark" />
              </button>
            ))}
          </div>
        ))
      }

      {
        scenarios.map((scn, si) => (
          <div class="diag__cardset" data-cardset={si} hidden={si !== 0}>
            {scn.pins.map((pin, pi) => (
              <div
                class="diag__card"
                data-card={pi}
                hidden={pi !== 0}
                style={cardSide(pin.x)}
                data-x={pin.x}
              >
                <p class="diag__card-kind">{pin.kind}</p>
                <p class="diag__card-title">{pin.title}</p>
                <p class="diag__card-body">{pin.body}</p>
                <p class="diag__card-ref">{pin.ref}</p>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .diag {
    background: var(--color-navy);
    padding: 120px var(--site-gutter);
    overflow: hidden;
  }
  .diag__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 480px minmax(0, 1fr);
    gap: 96px;
    align-items: center;
  }
  .diag__heading {
    margin: 24px 0;
    font-size: 46px;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #fff;
    text-wrap: balance;
  }
  .diag__body {
    margin: 0 0 32px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-concrete, #c9cfd8);
    text-wrap: pretty;
  }
  .diag__prompt {
    margin: 0 0 28px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-blueprint-ink);
  }
  .diag__nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .diag__nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .diag__nav-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.6);
  }
  .diag__nav-title {
    font-size: 14px;
    font-weight: 600;
    color: #fff;
  }
  .diag__nav-counter {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-blueprint-ink);
    font-variant-numeric: tabular-nums;
  }

  .diag__panel {
    position: relative;
    border-radius: var(--radius-frame);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .diag__photo {
    width: 100%;
    height: 560px;
    object-fit: cover;
    display: block;
  }
  .diag__photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(26, 26, 46, 0.1) 0%, rgba(26, 26, 46, 0.35) 100%);
  }
  .diag__pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #fff;
    background: rgba(26, 26, 46, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 16px rgba(16, 24, 40, 0.35);
    padding: 0;
  }
  .diag__pin:hover {
    transform: translate(-50%, -50%) scale(1.15);
  }
  .diag__pin[data-active] {
    background: var(--color-blue);
  }
  .diag__pin-mark {
    width: 22px;
    height: 22px;
    display: block;
    pointer-events: none;
  }
  .diag__card {
    position: absolute;
    bottom: 24px;
    width: 340px;
    max-width: calc(100% - 48px);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 20px 22px;
    box-shadow: 0 16px 48px rgba(16, 24, 40, 0.28);
  }
  .diag__card-kind {
    margin: 0 0 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--color-blueprint-ink);
  }
  .diag__card-title {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 600;
    color: var(--color-navy);
  }
  .diag__card-body {
    margin: 0 0 10px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
  .diag__card-ref {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-blue);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1100px) {
    .diag__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  @media (max-width: 899px) {
    .diag {
      padding: 72px var(--site-gutter);
    }
    .diag__card {
      left: 16px !important;
      right: 16px !important;
      width: auto;
      max-width: none;
    }
  }
</style>

<script define:vars={{ photoSrcs: optimized.map((o) => o.src), titles: scenarios.map((s) => s.title) }}>
  const panel = document.querySelector('[data-diag-panel]');
  const photo = panel?.querySelector('[data-diag-photo]');
  const titleEl = document.querySelector('[data-diag-title]');
  const counterEl = document.querySelector('[data-diag-counter]');
  const prevBtn = document.querySelector('[data-diag-prev]');
  const nextBtn = document.querySelector('[data-diag-next]');
  const pinsets = Array.from(document.querySelectorAll('[data-pinset]'));
  const cardsets = Array.from(document.querySelectorAll('[data-cardset]'));
  let scenario = 0;

  function showScenario(i) {
    scenario = (i + pinsets.length) % pinsets.length;
    pinsets.forEach((el, si) => (el.hidden = si !== scenario));
    cardsets.forEach((el, si) => (el.hidden = si !== scenario));
    setActivePin(scenario, 0);
    if (photo) photo.src = photoSrcs[scenario];
    if (titleEl) titleEl.textContent = titles[scenario];
    if (counterEl) counterEl.textContent = `${scenario + 1} / ${pinsets.length}`;
  }

  function setActivePin(si, pi) {
    const pins = Array.from(pinsets[si].querySelectorAll('[data-pin]'));
    const cards = Array.from(cardsets[si].querySelectorAll('[data-card]'));
    pins.forEach((p) => {
      if (Number(p.dataset.pin) === pi) p.setAttribute('data-active', '');
      else p.removeAttribute('data-active');
    });
    cards.forEach((c) => {
      c.hidden = Number(c.dataset.card) !== pi;
    });
  }

  pinsets.forEach((set, si) => {
    set.querySelectorAll('[data-pin]').forEach((btn) => {
      btn.addEventListener('click', () => setActivePin(si, Number(btn.dataset.pin)));
    });
  });

  prevBtn?.addEventListener('click', () => showScenario(scenario - 1));
  nextBtn?.addEventListener('click', () => showScenario(scenario + 1));
</script>
