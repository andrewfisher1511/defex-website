---
import Icon from './Icon.astro';

interface Props {
  icon: 'award' | 'shield-check' | 'pencil-ruler';
  label: string;
  size?: 'sm' | 'md';
}
const { icon, label, size = 'md' } = Astro.props;
---

<div class:list={['chip', `is-${size}`]}>
  <Icon name={icon} size={20} class="chip__icon" />
  <span class="chip__label">{label}</span>
</div>

<style>
  .chip {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--color-blueprint);
    border: 1px solid var(--color-blueprint-border);
    border-radius: var(--radius-card);
    padding: 14px 20px;
    min-height: 44px;
  }
  .chip.is-md {
    padding: 16px 20px;
  }
  .chip__icon {
    color: var(--color-blue);
    flex-shrink: 0;
  }
  .chip__label {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-navy);
    white-space: nowrap;
  }
</style>
