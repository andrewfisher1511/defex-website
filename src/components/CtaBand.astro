---
/**
 * CtaBand — navy full-bleed band, 128px padding, faint rotated mark
 * watermark, h2 52px Light white, blue button right. Every page ends here.
 */
import Icon from './Icon.astro';

interface Props {
  heading: string;
  contactLine?: boolean;
  body?: string;
  buttonLabel: string;
  buttonHref: string;
}
import { site } from '../lib/site.ts';
const { heading, contactLine = false, body, buttonLabel, buttonHref } = Astro.props;
---

<section class="cta-band">
  <img src="/brand/defex-mark-white.svg" alt="" aria-hidden="true" class="cta-band__watermark" />
  <div class="cta-band__inner" data-reveal>
    <div class="cta-band__copy">
      <h2 class="cta-band__heading">{heading}</h2>
      {
        contactLine ? (
          <p class="cta-band__contact">
            <a href={site.phoneHref}>{site.phone}</a>
            <span class="cta-band__dot">·</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        ) : (
          body && <p class="cta-band__body">{body}</p>
        )
      }
    </div>
    <a href={buttonHref} class="cta-band__button" data-reveal data-delay="120">
      {buttonLabel} <Icon name="arrow-right" size={16} />
    </a>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    background: var(--color-navy);
    padding: 128px var(--site-gutter);
    overflow: hidden;
  }
  .cta-band__watermark {
    position: absolute;
    right: -70px;
    top: 50%;
    transform: translateY(-50%) rotate(8deg);
    width: 460px;
    opacity: 0.05;
    pointer-events: none;
  }
  .cta-band__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 64px;
    position: relative;
    flex-wrap: wrap;
  }
  .cta-band__heading {
    margin: 0 0 20px;
    font-size: 52px;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #fff;
    text-wrap: balance;
  }
  .cta-band__body {
    margin: 0;
    font-size: 15px;
    color: var(--color-concrete, #c9cfd8);
  }
  .cta-band__contact {
    margin: 0;
    font-size: 15px;
    color: var(--color-concrete, #c9cfd8);
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .cta-band__contact a {
    color: var(--color-concrete, #c9cfd8);
    font-variant-numeric: tabular-nums;
  }
  .cta-band__contact a:hover {
    color: #fff;
  }
  .cta-band__dot {
    color: var(--color-steel);
  }
  .cta-band__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 16px 30px;
    background: var(--color-blue);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    border-radius: 8px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .cta-band__button:hover {
    background: var(--color-primary-hover);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.35);
  }
  .cta-band__button:active {
    transform: scale(0.97);
  }

  @media (max-width: 899px) {
    .cta-band {
      padding: 88px var(--site-gutter);
    }
    .cta-band__heading {
      font-size: 38px;
    }
  }
</style>
