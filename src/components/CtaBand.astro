---
/**
 * CtaBand — Navy full-bleed call-to-action band. White H2, optional body,
 * one primary button.
 */
import Button from './Button.astro';
import Reveal from './Reveal.astro';

interface Props {
  heading: string;
  body?: string;
  buttonLabel: string;
  buttonHref: string;
}
const { heading, body, buttonLabel, buttonHref } = Astro.props;
---

<section class="bg-navy">
  <div class="mx-auto max-w-site px-[var(--site-gutter)] py-16 md:py-24">
    <Reveal
      class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between"
    >
      <div class="max-w-2xl">
        <h2 class="text-3xl font-light tracking-[-0.02em] text-white md:text-4xl">
          {heading}
        </h2>
        {body && <p class="mt-3 text-lg text-concrete">{body}</p>}
      </div>
      <div class="shrink-0">
        <Button href={buttonHref}>{buttonLabel}</Button>
      </div>
    </Reveal>
  </div>
</section>
