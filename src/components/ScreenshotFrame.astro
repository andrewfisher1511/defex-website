---
/**
 * ScreenshotFrame — product-shot treatment (spec §7). Navy frame, 16px radius,
 * 8px padding, minimal window bar (three Concrete dots at 40%), screenshot at
 * 8px radius + shadow-lg, optional caption. On Navy sections set `onDark` to
 * invert the frame to white-6% with a Concrete hairline. Never upscaled: 2×
 * srcset is capped at native resolution by astro:assets.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  onDark?: boolean;
  /** CSS display width in px used to size the srcset. */
  displayWidth?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const {
  image,
  alt,
  caption,
  onDark = false,
  displayWidth = 480,
  loading = 'lazy',
  class: className = '',
} = Astro.props;

const frame = onDark
  ? 'bg-white/[0.06] ring-1 ring-concrete/25'
  : 'bg-navy';
---

<figure class={`w-full ${className}`}>
  <div class={`rounded-frame p-2 ${frame}`}>
    <div class="flex items-center gap-1.5 px-1.5 py-2" aria-hidden="true">
      <span class="h-2 w-2 rounded-full bg-concrete/40"></span>
      <span class="h-2 w-2 rounded-full bg-concrete/40"></span>
      <span class="h-2 w-2 rounded-full bg-concrete/40"></span>
    </div>
    <Picture
      src={image}
      formats={['avif', 'webp']}
      fallbackFormat="png"
      alt={alt}
      width={displayWidth}
      densities={[1, 2]}
      loading={loading}
      class="w-full rounded-[8px] shadow-lg"
    />
  </div>
  {
    caption && (
      <figcaption class="mt-3 text-center text-xs text-steel">
        {caption}
      </figcaption>
    )
  }
</figure>
