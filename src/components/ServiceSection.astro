---
/**
 * ServiceSection — one anchored service on the Services page. Anchor id = slug.
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Reveal from './Reveal.astro';

interface Props {
  entry: CollectionEntry<'services'>;
  first?: boolean;
}
const { entry, first = false } = Astro.props;
const { Content } = await render(entry);
---

<section
  id={entry.data.slug}
  class:list={[
    'scroll-mt-24 py-12 md:py-16',
    !first && 'border-t border-border',
  ]}
>
  <Reveal>
    <h2 class="text-2xl font-semibold tracking-[-0.02em] text-navy md:text-3xl">
      {entry.data.title}
    </h2>
    <div class="prose mt-5 max-w-[68ch] text-lg leading-relaxed text-ink-body">
      <Content />
    </div>
  </Reveal>
</section>
