---
/**
 * Eyebrow — 48px blue rule + 13px semibold wide-tracked label. Used at the
 * top of every section per the rev2 shared shell.
 */
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className = '' } = Astro.props;
---

<div class:list={['eyebrow', className]}>
  <span class="eyebrow__rule"></span>
  <span class:list={['eyebrow__label', { 'is-dark': tone === 'dark' }]}><slot /></span>
</div>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .eyebrow__rule {
    display: block;
    width: 48px;
    height: 2px;
    background: var(--color-blue);
    flex-shrink: 0;
  }
  .eyebrow__label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--color-steel);
    white-space: nowrap;
  }
  .eyebrow__label.is-dark {
    color: var(--color-concrete, #c9cfd8);
  }
</style>
