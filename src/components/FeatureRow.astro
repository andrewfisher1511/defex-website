---
/**
 * FeatureRow — one alternating feature on the DEFEX App page. Text one side,
 * media the other (sides alternate by index). Media is a ScreenshotFrame when
 * the feature has a screenshot; feature 2 has screenshot:null and renders the
 * sanctioned typographic defect-line panel instead (§5.4).
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { getScreenshot } from '../lib/images.ts';
import ScreenshotFrame from './ScreenshotFrame.astro';
import Reveal from './Reveal.astro';

interface Props {
  entry: CollectionEntry<'app-features'>;
  index: number;
  caption?: string;
}
const { entry, index, caption } = Astro.props;
const { Content } = await render(entry);
const mediaRight = index % 2 === 0; // feature 1 (index 0) → media right
const shot = entry.data.screenshot ? getScreenshot(entry.data.screenshot) : null;
---

<article class="grid items-center gap-8 md:grid-cols-2 md:gap-14">
  <Reveal class:list={['order-2', mediaRight ? 'md:order-1' : 'md:order-2']}>
    <h2 class="text-2xl font-semibold tracking-[-0.02em] text-navy md:text-3xl">
      {entry.data.title}
    </h2>
    <div class="prose mt-4 max-w-[54ch] text-lg leading-relaxed text-ink-body">
      <Content />
    </div>
  </Reveal>

  <Reveal
    index={1}
    class:list={['order-1', mediaRight ? 'md:order-2' : 'md:order-1']}
  >
    {
      shot ? (
        <ScreenshotFrame
          image={shot}
          alt={entry.data.title}
          caption={caption}
          displayWidth={520}
        />
      ) : (
        <div class="rounded-frame border border-blueprint-border bg-blueprint p-6 md:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.1em] text-steel">
            Defect register
          </p>
          <div class="mt-4 rounded-card border border-blueprint-border bg-surface p-4">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="tnum text-base font-semibold text-blue">DEF-014</span>
              <span aria-hidden="true" class="text-steel">·</span>
              <span class="text-base font-medium text-navy">
                Membrane termination
              </span>
              <span aria-hidden="true" class="text-steel">—</span>
              <span class="tnum text-base text-ink-muted">AS 4654.2</span>
            </div>
          </div>
        </div>
      )
    }
  </Reveal>
</article>
