---
/**
 * Hero — full-width photo hero (Home 820px / About 760px), navy→blue gradient
 * overlay, parallax wrap + 6s photo scale-in + staggered text (Base.astro).
 */
import { Image } from 'astro:assets';
import { heroImage } from '../lib/images.ts';

interface Props {
  eyebrow: string;
  heading: string;
  sub: string;
  height?: number;
  showScrollCue?: boolean;
}
const { eyebrow, heading, sub, height = 820, showScrollCue = false } = Astro.props;
---

<header id="hero" data-hero class="hero" style={`--hero-height:${height}px`}>
  <div data-hero-parallax class="hero__wrap">
    <Image
      data-hero-photo
      src={heroImage}
      alt="Architectural concrete facade"
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
      class="hero__photo"
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content">
    <div class="hero__inner">
      <div data-hero-seq="0" class="hero__eyebrow">
        <span class="hero__rule"></span>
        <span class="hero__eyebrow-label">{eyebrow}</span>
      </div>
      <h1 data-hero-seq="1" class="hero__heading">{heading}</h1>
      <p data-hero-seq="2" class="hero__sub">{sub}</p>
      <div data-hero-seq="3" class="hero__buttons">
        <slot name="buttons" />
      </div>
    </div>
  </div>
  {
    showScrollCue && (
      <div class="hero__scroll" aria-hidden="true">
        <span class="hero__scroll-label">SCROLL</span>
        <span class="hero__scroll-line" />
      </div>
    )
  }
</header>

<style>
  .hero {
    position: relative;
    height: var(--hero-height);
    overflow: hidden;
    background: var(--color-navy);
  }
  .hero__wrap {
    position: absolute;
    top: -90px;
    bottom: -90px;
    left: 0;
    right: 0;
    will-change: transform;
  }
  .hero__wrap :global(picture),
  .hero__wrap :global(img) {
    width: 100%;
    height: 100%;
  }
  .hero__wrap :global(img) {
    object-fit: cover;
    display: block;
    will-change: transform;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      rgba(26, 26, 46, 0.93) 0%,
      rgba(26, 26, 46, 0.62) 48%,
      rgba(37, 99, 235, 0.42) 100%
    );
  }
  .hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 0 104px;
  }
  .hero__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    padding: 0 var(--site-gutter);
  }
  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }
  .hero__rule {
    display: block;
    width: 48px;
    height: 2px;
    background: var(--color-blue);
  }
  .hero__eyebrow-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--color-concrete, #c9cfd8);
    white-space: nowrap;
  }
  .hero__heading {
    margin: 0 0 28px;
    max-width: 1100px;
    font-size: 104px;
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #fff;
    text-wrap: balance;
  }
  .hero__sub {
    margin: 0 0 40px;
    max-width: 620px;
    font-size: 18px;
    line-height: 1.6;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.78);
  }
  .hero__buttons {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero__scroll {
    position: absolute;
    right: 40px;
    bottom: 104px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .hero__scroll-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.6);
    writing-mode: vertical-rl;
  }
  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 56px;
    background: rgba(255, 255, 255, 0.35);
  }

  @media (max-width: 899px) {
    .hero {
      height: 560px;
    }
    .hero__heading {
      font-size: clamp(40px, 11vw, 76px);
    }
    .hero__content {
      padding-bottom: 56px;
    }
    .hero__scroll {
      display: none;
    }
  }
</style>
