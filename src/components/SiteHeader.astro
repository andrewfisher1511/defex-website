---
/**
 * SiteHeader — fixed translucent nav (72px desktop / 64px mobile). Hairline +
 * shadow toggle at 8px scroll (Base.astro's shared scroll script). Below
 * 900px switches to a hamburger + full-screen drawer per mobile-nav-spec.
 */
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { site } from '../lib/site.ts';

const nav = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Projects', href: '/projects' },
  { label: 'DEFEX App', href: '/defex-app' },
  { label: 'About', href: '/about' },
  { label: 'Blog', href: '/blog' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<nav id="site-nav" class="site-nav" aria-label="Primary">
  <div class="site-nav__row">
    <a href="/" class="site-nav__logo" aria-label="DEFEX Engineering home">
      <Brand markSize={30} />
    </a>

    <div class="site-nav__links">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
      <a href={site.appUrl} target="_blank" rel="noopener" class="site-nav__login">
        <Icon name="lock" size={14} /> Log in
      </a>
      <a
        href="/contact"
        class:list={['site-nav__contact', { 'is-current': isActive('/contact') }]}
      >
        Contact
      </a>
    </div>

    <button
      id="nav-toggle"
      class="site-nav__toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <span class="site-nav__toggle-icon" aria-hidden="true">
        <Icon name="menu" size={24} />
      </span>
    </button>
  </div>
</nav>

<!-- Mobile drawer -->
<div id="mobile-drawer" class="mobile-drawer" hidden>
  <nav class="mobile-drawer__links" aria-label="Mobile">
    {
      nav.map((item, i) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-drawer-link
          style={`--i:${i}`}
          class:list={['mobile-drawer__link', { 'is-active': isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))
    }
    <a href="/contact" class="mobile-drawer__cta" data-drawer-link style={`--i:${nav.length}`}>
      Contact
    </a>
  </nav>
  <div class="mobile-drawer__footer">
    <a href={site.appUrl} target="_blank" rel="noopener" class="mobile-drawer__login">
      <Icon name="lock" size={14} /> Log in to DEFEX
    </a>
    <a href={site.phoneHref}>{site.phone}</a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</div>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(228, 231, 236, 0);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .site-nav[data-scrolled] {
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 8px rgba(16, 24, 40, 0.05);
  }
  .site-nav__row {
    max-width: var(--container-site);
    margin: 0 auto;
    padding: 0 var(--site-gutter);
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .site-nav__logo {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink-muted);
    border-radius: 8px;
    border-bottom: 2px solid transparent;
    transition: all 0.2s ease;
  }
  .site-nav__link:hover {
    color: var(--color-navy);
    background: var(--color-nav-wash);
  }
  .site-nav__link.is-active {
    color: var(--color-navy);
    font-weight: 600;
    border-radius: 0;
    border-bottom-color: var(--color-blue);
    background: none;
  }
  .site-nav__login {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-left: 14px;
    padding: 0 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-navy);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .site-nav__login:hover {
    border-color: var(--color-blue);
    color: var(--color-blue);
  }
  .site-nav__contact {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-left: 14px;
    padding: 0 20px;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    background: var(--color-blue);
    border-radius: 8px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .site-nav__contact:hover {
    background: var(--color-primary-hover);
    color: #fff;
  }
  .site-nav__contact:active {
    transform: scale(0.97);
  }
  .site-nav__contact.is-current {
    background: var(--color-primary-hover);
  }
  .site-nav__toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: var(--color-navy);
    border-radius: 8px;
    cursor: pointer;
  }
  .site-nav__toggle-icon {
    display: flex;
  }

  @media (max-width: 1100px) {
    .site-nav__link {
      padding: 0 8px;
    }
  }
  @media (max-width: 899px) {
    .site-nav__row {
      height: 64px;
    }
    .site-nav__links {
      display: none;
    }
    .site-nav__toggle {
      display: flex;
    }
  }

  .mobile-drawer {
    position: fixed;
    inset: 64px 0 0 0;
    z-index: 190;
    background: #fff;
    overflow-y: auto;
    padding: 0 24px 32px;
    display: flex;
    flex-direction: column;
  }
  .mobile-drawer[hidden] {
    display: none;
  }
  .mobile-drawer__links {
    display: flex;
    flex-direction: column;
  }
  .mobile-drawer__link {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-size: 18px;
    font-weight: 500;
    color: var(--color-navy);
    border-bottom: 1px solid var(--color-row-line);
  }
  .mobile-drawer__link.is-active {
    font-weight: 600;
    border-left: 3px solid var(--color-blue);
    background: var(--color-blueprint);
    padding-left: 13px;
    margin-left: -16px;
    padding-right: 16px;
  }
  .mobile-drawer__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 24px;
    background: var(--color-blue);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    border-radius: 8px;
  }
  .mobile-drawer__footer {
    margin-top: auto;
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    color: var(--color-steel);
  }
  .mobile-drawer__footer a {
    color: var(--color-steel);
  }
  .mobile-drawer__login {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--color-navy) !important;
    margin-bottom: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-drawer.is-animating [data-drawer-link] {
      animation: drawer-link-in 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i) * 30ms);
    }
  }
  @keyframes drawer-link-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
  const drawer = document.getElementById('mobile-drawer');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let lastFocused: HTMLElement | null = null;

  function setOpen(open: boolean) {
    if (!toggle || !drawer) return;
    drawer.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      lastFocused = document.activeElement as HTMLElement;
      if (!reduce) {
        drawer.classList.add('is-animating');
      }
      const first = drawer.querySelector<HTMLElement>('[data-drawer-link]');
      first?.focus();
    } else {
      drawer.classList.remove('is-animating');
      lastFocused?.focus();
    }
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!open);
  });

  document.addEventListener('keydown', (e) => {
    if (!drawer || drawer.hidden) return;
    if (e.key === 'Escape') {
      setOpen(false);
      return;
    }
    if (e.key === 'Tab') {
      const focusable = Array.from(
        drawer.querySelectorAll<HTMLElement>('a, button')
      );
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
