---
/**
 * Brand — the DEFEX lockup: X-in-frame mark (Option A "Engineered") + wordmark.
 * `tone` controls the mark frame/arms and wordmark ink; the diamond centre is
 * always Electric Blue. `markOnly` renders just the mark (≤480px in the header).
 * Built as inline SVG + text so it stays crisp and theme-controlled.
 */
interface Props {
  tone?: 'navy' | 'white';
  markOnly?: boolean;
  class?: string;
  markSize?: number;
}
const {
  tone = 'navy',
  markOnly = false,
  class: className = '',
  markSize = 34,
} = Astro.props;

const ink = tone === 'white' ? '#ffffff' : '#1a1a2e';
const wordTop = tone === 'white' ? 'text-white' : 'text-navy';
const wordBottom = tone === 'white' ? 'text-concrete' : 'text-steel';
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    width={markSize}
    height={markSize}
    viewBox="0 0 120 120"
    role="img"
    aria-label="DEFEX Engineering"
    class="shrink-0"
  >
    <rect
      x="10"
      y="10"
      width="100"
      height="100"
      rx="18"
      fill="none"
      stroke={ink}
      stroke-width="7"></rect>
    <g transform="rotate(45 60 60)" fill={ink}>
      <rect x="72" y="53" width="40" height="14"></rect>
      <rect x="8" y="53" width="40" height="14"></rect>
      <rect x="53" y="72" width="14" height="40"></rect>
      <rect x="53" y="8" width="14" height="40"></rect>
    </g>
    <rect
      x="52.5"
      y="52.5"
      width="15"
      height="15"
      transform="rotate(45 60 60)"
      fill="#2563eb"></rect>
  </svg>

  {
    !markOnly && (
      <span class="flex flex-col leading-none">
        <span
          class={`text-lg font-bold tracking-[0.02em] ${wordTop}`}
          style="line-height:1"
        >
          DEFE<span class="text-blue">X</span>
        </span>
        <span
          class={`mt-0.5 text-[9px] font-semibold uppercase ${wordBottom}`}
          style="letter-spacing:0.34em;line-height:1"
        >
          Engineering
        </span>
      </span>
    )
  }
</span>
