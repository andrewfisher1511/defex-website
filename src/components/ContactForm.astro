---
/**
 * ContactForm — enquiry form card + success state. Vanilla JS (no framework):
 * role pill toggle, mocked address suggestions + Maps button, drag/drop
 * uploads, client validation, then a real POST to /api/enquiry. The success
 * screen renders the subject line and urgency flag the function returns.
 */
import Icon from './Icon.astro';

const roles = ['Owner', 'Strata manager', 'Body corporate', 'Builder', 'Insurer', 'Other'];
---

<div class="cf">
  <form id="cf-form" class="cf-card" data-reveal data-delay="80" novalidate>
    <div class="cf-field">
      <label for="cf-name">Name <span class="cf-required">*</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />
      <span class="cf-error" data-error-for="name" hidden></span>
    </div>

    <div class="cf-row">
      <div class="cf-field">
        <label for="cf-email">Email <span class="cf-required">*</span></label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required />
        <span class="cf-error" data-error-for="email" hidden></span>
      </div>
      <div class="cf-field">
        <label for="cf-phone">Phone</label>
        <input id="cf-phone" name="phone" type="tel" autocomplete="tel" class="cf-tabular" />
      </div>
    </div>

    <div class="cf-field">
      <span class="cf-label">I am the</span>
      <div class="cf-roles" id="cf-roles">
        {roles.map((r) => <button type="button" class="cf-role" data-role={r}>{r}</button>)}
      </div>
      <input type="hidden" name="role" id="cf-role-value" />
    </div>

    <div class="cf-field">
      <label for="cf-address">Building address</label>
      <div class="cf-address-row">
        <div class="cf-address-input-wrap">
          <input
            id="cf-address"
            name="address"
            type="text"
            placeholder="Start typing — street, suburb"
            autocomplete="off"
          />
          <div id="cf-suggestions" class="cf-suggestions" hidden></div>
        </div>
        <button type="button" id="cf-maps" class="cf-maps" disabled aria-label="Open address in Google Maps" title="Open in Google Maps">
          <Icon name="map-pin" size={18} /> <span>Maps</span>
        </button>
      </div>
      <span class="cf-hint">
        Suggestions are indicative — production uses Google Places Autocomplete. The Maps button checks
        the address you have typed.
      </span>
      <div id="cf-area-note" class="cf-note" hidden>
        <Icon name="info" size={16} />
        <span>This looks outside Sydney metro. Greater NSW is occasionally covered — still worth sending the details.</span>
      </div>
    </div>

    <div class="cf-field">
      <label for="cf-desc">What&rsquo;s happening with the building? <span class="cf-required">*</span></label>
      <textarea
        id="cf-desc"
        name="description"
        rows="6"
        required
        placeholder="Symptoms, where they appear, and how long they have been present — water ingress, cracking, spalling, movement, failed finishes."
      ></textarea>
      <span class="cf-error" data-error-for="description" hidden></span>
    </div>

    <div class="cf-field">
      <label for="cf-hear">How did you hear about us?</label>
      <input id="cf-hear" name="hearAbout" type="text" placeholder="Referral, search, strata manager, previous project…" />
    </div>

    <div class="cf-field">
      <span class="cf-label">Photographs or documents</span>
      <div id="cf-dropzone" class="cf-dropzone" role="button" tabindex="0">
        <Icon name="upload" size={22} />
        <span class="cf-dropzone__title">Drop files here, or click to browse</span>
        <span class="cf-dropzone__hint">Photos, PDFs, reports — up to 10 files</span>
      </div>
      <input id="cf-files" type="file" multiple hidden aria-hidden="true" />
      <div id="cf-filelist" class="cf-filelist"></div>
    </div>

    <div class="cf-submit-row">
      <button type="submit" id="cf-submit" class="cf-submit">
        <span data-label>Send enquiry</span> <Icon name="arrow-right" size={16} />
      </button>
      <span id="cf-error-summary" class="cf-error-summary" hidden></span>
    </div>
    <p class="cf-microcopy">Details are used only to respond to this enquiry.</p>
    <input type="hidden" name="hp" id="cf-hp" autocomplete="off" tabindex="-1" aria-hidden="true" />
    <input type="hidden" name="t" id="cf-t" />
  </form>

  <div id="cf-success" class="cf-success" hidden>
    <span class="cf-success__icon"><Icon name="check" size={26} /></span>
    <h2 class="cf-success__heading">Enquiry sent.</h2>
    <p class="cf-success__body">
      Thanks <span id="cf-success-name"></span> — the details are on their way to Andrew. If the matter
      is urgent, call <a href="tel:+61432261722">0432 261 722</a> directly.
    </p>
    <p class="cf-success__filesummary" id="cf-success-files"></p>

    <div class="cf-preview">
      <div class="cf-preview__bar">
        <span>WHAT ANDREW RECEIVES</span>
        <span class="cf-preview__tag">SUBJECT SUMMARISED AUTOMATICALLY</span>
      </div>
      <div class="cf-preview__body">
        <div class="cf-preview__row">
          <span class="cf-preview__key">To</span>
          <span>andrew@defex.engineering</span>
        </div>
        <div class="cf-preview__row">
          <span class="cf-preview__key">Subject</span>
          <span class="cf-preview__subject-wrap">
            <span id="cf-urgent-tag" class="cf-urgent-tag" hidden>
              <Icon name="alert-triangle" size={12} /> URGENT — ACTIVE WATER INDICATED
            </span>
            <span id="cf-subject-line" class="cf-subject-line"></span>
          </span>
        </div>
        <div class="cf-preview__actions">
          <span class="cf-preview__action cf-preview__action--primary">
            <Icon name="kanban-square" size={15} /> Add to DEFEX Command as potential job
          </span>
          <span class="cf-preview__action cf-preview__action--secondary">
            <Icon name="users" size={15} /> Create CRM contact
          </span>
          <span class="cf-preview__action-note">One-tap links inside the email — every field pre-filled.</span>
        </div>
      </div>
    </div>

    <button type="button" id="cf-reset" class="cf-reset">Send another enquiry</button>
  </div>
</div>

<style>
  .cf-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-frame);
    padding: 44px 48px;
    box-shadow: 0 2px 12px rgba(16, 24, 40, 0.04);
  }
  .cf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .cf-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cf-field label,
  .cf-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-navy);
  }
  .cf-required {
    color: var(--color-error);
  }
  .cf-field input[type='text'],
  .cf-field input[type='email'],
  .cf-field input[type='tel'],
  .cf-field textarea {
    min-height: 44px;
    padding: 10px 14px;
    font-size: 16px;
    font-family: inherit;
    color: var(--color-ink-body);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }
  .cf-field input:focus,
  .cf-field textarea:focus {
    outline: 2px solid var(--color-blue);
    outline-offset: 1px;
    border-color: var(--color-blue);
  }
  .cf-field textarea {
    padding: 12px 14px;
    line-height: 1.6;
    resize: vertical;
  }
  .cf-tabular {
    font-variant-numeric: tabular-nums;
  }
  .cf-field.has-error input,
  .cf-field.has-error textarea {
    border-color: var(--color-error);
    box-shadow: 0 0 0 1px var(--color-error);
  }
  .cf-error {
    font-size: 13px;
    color: var(--color-error);
  }

  .cf-roles {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cf-role {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
    background: #fff;
    color: var(--color-ink-muted);
    border: 1px solid var(--color-border);
  }
  .cf-role:hover {
    border-color: var(--color-blue);
  }
  .cf-role.is-active {
    background: var(--color-blue);
    color: #fff;
    border-color: var(--color-blue);
  }

  .cf-address-row {
    display: flex;
    gap: 10px;
  }
  .cf-address-input-wrap {
    position: relative;
    flex: 1;
  }
  .cf-address-input-wrap input {
    width: 100%;
    box-sizing: border-box;
  }
  .cf-suggestions {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 50;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 12px 32px rgba(16, 24, 40, 0.14);
    overflow: hidden;
  }
  .cf-suggestion {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 44px;
    padding: 10px 14px;
    background: #fff;
    border: none;
    border-bottom: 1px solid var(--color-row-line);
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    color: var(--color-ink-body);
    text-align: left;
    transition: background 0.2s ease;
  }
  .cf-suggestion:last-child {
    border-bottom: none;
  }
  .cf-suggestion:hover {
    background: var(--color-blueprint);
  }
  .cf-maps {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    border-radius: 8px;
    transition: all 0.2s ease;
    white-space: nowrap;
    background: #f2f4f7;
    color: var(--color-grey);
    border: 1px solid var(--color-border);
    cursor: not-allowed;
  }
  .cf-maps.is-enabled {
    background: var(--color-blueprint);
    color: var(--color-blue);
    border-color: var(--color-blueprint-border);
    cursor: pointer;
  }
  .cf-hint {
    font-size: 13px;
    color: var(--color-grey);
  }
  .cf-note {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--color-blueprint);
    border: 1px solid var(--color-blueprint-border);
    border-radius: 8px;
    padding: 12px 16px;
  }
  .cf-note span {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  .cf-note :global(svg) {
    color: var(--color-blue);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cf-dropzone {
    border: 2px dashed var(--color-concrete, #c9cfd8);
    border-radius: var(--radius-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    background: var(--color-canvas);
    transition: all 0.2s ease;
  }
  .cf-dropzone:hover,
  .cf-dropzone.is-dragover {
    border-color: var(--color-blue);
    background: var(--color-blueprint);
  }
  .cf-dropzone :global(svg) {
    color: var(--color-blue);
  }
  .cf-dropzone__title {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-navy);
  }
  .cf-dropzone__hint {
    font-size: 13px;
    color: var(--color-grey);
  }
  .cf-filelist {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cf-filelist:not(:empty) {
    margin-top: 4px;
  }
  .cf-file {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 10px 14px;
  }
  .cf-file__name {
    flex: 1;
    font-size: 14px;
    color: var(--color-ink-body);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cf-file__size {
    font-size: 13px;
    color: var(--color-grey);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .cf-file__remove {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--color-grey);
    cursor: pointer;
    border-radius: 6px;
  }
  .cf-file__remove:hover {
    color: var(--color-error);
    background: var(--color-error-bg);
  }

  .cf-submit-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 8px;
    flex-wrap: wrap;
  }
  .cf-submit {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 14px 30px;
    background: var(--color-blue);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .cf-submit:hover {
    background: var(--color-primary-hover);
  }
  .cf-submit:active {
    transform: scale(0.97);
  }
  .cf-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .cf-error-summary {
    font-size: 14px;
    color: var(--color-error);
  }
  .cf-microcopy {
    margin: 0;
    font-size: 13px;
    color: var(--color-grey);
  }
  #cf-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
  }

  .cf-success {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-frame);
    padding: 56px 48px;
    box-shadow: 0 2px 12px rgba(16, 24, 40, 0.04);
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }
  .cf-success__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-success-bg);
    color: var(--color-success);
  }
  .cf-success__heading {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  .cf-success__body {
    margin: 0;
    max-width: 56ch;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }
  .cf-success__body a {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .cf-success__filesummary {
    margin: 0;
    font-size: 14px;
    color: var(--color-grey);
  }

  .cf-preview {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-top: 8px;
  }
  .cf-preview__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-border);
    padding: 12px 20px;
  }
  .cf-preview__bar span:first-child {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--color-grey);
    white-space: nowrap;
  }
  .cf-preview__tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-blueprint-ink);
    background: var(--color-blueprint);
    border: 1px solid var(--color-blueprint-border);
    border-radius: 999px;
    padding: 4px 10px;
    white-space: nowrap;
  }
  .cf-preview__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cf-preview__row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
  }
  .cf-preview__key {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-grey);
  }
  .cf-preview__subject-wrap {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .cf-urgent-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-error);
    background: var(--color-error-bg);
    border-radius: 999px;
    padding: 4px 12px;
    white-space: nowrap;
  }
  .cf-subject-line {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-navy);
  }
  .cf-preview__actions {
    border-top: 1px solid var(--color-row-line);
    padding-top: 14px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }
  .cf-preview__action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    border-radius: 8px;
    padding: 10px 16px;
    white-space: nowrap;
  }
  .cf-preview__action--primary {
    color: #fff;
    background: var(--color-blue);
  }
  .cf-preview__action--secondary {
    color: var(--color-blue);
    background: var(--color-blueprint);
    border: 1px solid var(--color-blueprint-border);
  }
  .cf-preview__action-note {
    font-size: 12px;
    color: var(--color-grey);
  }

  .cf-reset {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 20px;
    background: transparent;
    color: var(--color-blue);
    font-size: 14px;
    font-weight: 600;
    font-family: inherit;
    border: 1px solid var(--color-blueprint-border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .cf-reset:hover {
    background: var(--color-blueprint);
  }

  @media (max-width: 899px) {
    .cf-card,
    .cf-success {
      padding: 24px;
    }
    .cf-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const ROLE_OPTIONS = ['Owner', 'Strata manager', 'Body corporate', 'Builder', 'Insurer', 'Other'];
  const ADDRESS_POOL = [
    '12 Harbour Street, Pyrmont', '88 Foreshore Road, Botany', '5 Beaconsfield Parade, Lindfield',
    '42 Ocean Street, Cronulla', '17 Kembla Crescent, Ryde', '230 Victoria Road, Gladesville',
    '9 Grand Parade, Brighton-Le-Sands', '3 Mount Street, North Sydney', '76 Norton Street, Leichhardt',
    '21 Gymea Bay Road, Gymea', '14 Marine Parade, Manly', '58 Church Street, Parramatta',
    '33 Anzac Parade, Kensington', '7 Railway Parade, Hurstville', '105 Pacific Highway, Chatswood',
  ];
  const REGIONAL_MARKERS = [
    'wollongong', 'newcastle', 'gosford', 'central coast', 'blue mountains', 'katoomba', 'orange',
    'bathurst', 'dubbo', 'coffs', 'wagga', 'tamworth', 'byron', 'ballina', 'goulburn', 'nowra', 'kiama',
    'shellharbour', 'albury', 'armidale',
  ];

  const form = document.getElementById('cf-form') as HTMLFormElement;
  const successEl = document.getElementById('cf-success') as HTMLElement;
  const roleWrap = document.getElementById('cf-roles') as HTMLElement;
  const roleValue = document.getElementById('cf-role-value') as HTMLInputElement;
  const addressInput = document.getElementById('cf-address') as HTMLInputElement;
  const suggestionsEl = document.getElementById('cf-suggestions') as HTMLElement;
  const mapsBtn = document.getElementById('cf-maps') as HTMLButtonElement;
  const areaNote = document.getElementById('cf-area-note') as HTMLElement;
  const dropzone = document.getElementById('cf-dropzone') as HTMLElement;
  const fileInput = document.getElementById('cf-files') as HTMLInputElement;
  const fileListEl = document.getElementById('cf-filelist') as HTMLElement;
  const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement;
  const errorSummary = document.getElementById('cf-error-summary') as HTMLElement;

  // Real client-side render timestamp — the page is statically generated, so
  // this must be set at load, not baked in at build time, for the server's
  // time-gate check to mean anything.
  const tField = document.getElementById('cf-t') as HTMLInputElement;
  if (tField) tField.value = String(Date.now());

  let selectedRole = '';
  let files: File[] = [];

  // Role pills
  roleWrap.querySelectorAll<HTMLButtonElement>('.cf-role').forEach((btn) => {
    btn.addEventListener('click', () => {
      const r = btn.dataset.role || '';
      selectedRole = selectedRole === r ? '' : r;
      roleValue.value = selectedRole;
      roleWrap.querySelectorAll('.cf-role').forEach((b) =>
        b.classList.toggle('is-active', b === btn && selectedRole !== '')
      );
    });
  });

  // Address suggestions + Maps button + regional note
  addressInput.addEventListener('input', () => {
    const q = addressInput.value.trim().toLowerCase();
    const matches = q.length >= 3 ? ADDRESS_POOL.filter((a) => a.toLowerCase().includes(q)).slice(0, 4) : [];
    suggestionsEl.innerHTML = '';
    matches.forEach((m) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'cf-suggestion';
      btn.textContent = m;
      btn.addEventListener('click', () => {
        addressInput.value = m;
        suggestionsEl.hidden = true;
        suggestionsEl.innerHTML = '';
        syncAddressState();
      });
      suggestionsEl.appendChild(btn);
    });
    suggestionsEl.hidden = matches.length === 0;
    syncAddressState();
  });

  function syncAddressState() {
    const val = addressInput.value.trim();
    mapsBtn.disabled = !val;
    mapsBtn.classList.toggle('is-enabled', !!val);
    const lower = val.toLowerCase();
    areaNote.hidden = !(val.length > 3 && REGIONAL_MARKERS.some((m) => lower.includes(m)));
  }

  mapsBtn.addEventListener('click', () => {
    const q = addressInput.value.trim();
    if (!q) return;
    window.open(
      `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q + ', NSW, Australia')}`,
      '_blank'
    );
  });

  // Uploads
  function fmtSize(bytes: number) {
    if (bytes > 1048576) return (bytes / 1048576).toFixed(1) + ' MB';
    if (bytes > 1024) return Math.round(bytes / 1024) + ' KB';
    return bytes + ' B';
  }
  function fileIcon(name: string) {
    const n = name.toLowerCase();
    if (/\.(jpg|jpeg|png|heic|webp|gif)$/.test(n)) return 'image';
    if (/\.pdf$/.test(n)) return 'file-text';
    return 'file';
  }
  const ICON_SVGS: Record<string, string> = {
    image: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/>',
    'file-text':
      '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>',
    file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>',
  };
  function renderFiles() {
    fileListEl.innerHTML = '';
    files.forEach((f, i) => {
      const row = document.createElement('div');
      row.className = 'cf-file';
      row.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-blue);flex-shrink:0">${ICON_SVGS[fileIcon(f.name)]}</svg>
        <span class="cf-file__name">${f.name}</span>
        <span class="cf-file__size">${fmtSize(f.size)}</span>
      `;
      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'cf-file__remove';
      removeBtn.setAttribute('aria-label', 'Remove file');
      removeBtn.innerHTML =
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
      removeBtn.addEventListener('click', () => {
        files.splice(i, 1);
        renderFiles();
      });
      row.appendChild(removeBtn);
      fileListEl.appendChild(row);
    });
  }
  function addFiles(list: FileList | File[]) {
    const incoming = Array.from(list).slice(0, 10 - files.length);
    files = files.concat(incoming);
    renderFiles();
  }
  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('is-dragover');
  });
  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('is-dragover'));
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('is-dragover');
    if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
  });
  fileInput.addEventListener('change', () => {
    if (fileInput.files) addFiles(fileInput.files);
    fileInput.value = '';
  });

  // Validation + submit
  function setFieldError(name: string, message: string) {
    const field = form.querySelector(`[name="${name}"]`)?.closest('.cf-field');
    const errEl = form.querySelector(`[data-error-for="${name}"]`) as HTMLElement | null;
    field?.classList.toggle('has-error', !!message);
    if (errEl) {
      errEl.textContent = message;
      errEl.hidden = !message;
    }
  }

  // Clear a field's error as soon as it becomes valid, rather than making the
  // visitor wait for the next submit click to see the red border lift.
  (form.querySelector('[name="name"]') as HTMLInputElement).addEventListener('input', (e) => {
    if ((e.target as HTMLInputElement).value.trim()) setFieldError('name', '');
  });
  (form.querySelector('[name="email"]') as HTMLInputElement).addEventListener('input', (e) => {
    const v = (e.target as HTMLInputElement).value.trim();
    if (v && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) setFieldError('email', '');
  });
  (form.querySelector('[name="description"]') as HTMLTextAreaElement).addEventListener('input', (e) => {
    if ((e.target as HTMLTextAreaElement).value.trim()) setFieldError('description', '');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (form.querySelector('[name="name"]') as HTMLInputElement).value.trim();
    const email = (form.querySelector('[name="email"]') as HTMLInputElement).value.trim();
    const description = (form.querySelector('[name="description"]') as HTMLTextAreaElement).value.trim();

    let hasError = false;
    setFieldError('name', '');
    setFieldError('email', '');
    setFieldError('description', '');
    if (!name) {
      setFieldError('name', 'Name is required.');
      hasError = true;
    }
    if (!email) {
      setFieldError('email', 'Email is required.');
      hasError = true;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setFieldError('email', 'Enter a valid email address.');
      hasError = true;
    }
    if (!description) {
      setFieldError('description', 'A short description of the symptoms is required.');
      hasError = true;
    }
    if (hasError) {
      errorSummary.textContent = 'Complete the required fields above.';
      errorSummary.hidden = false;
      return;
    }
    errorSummary.hidden = true;

    const fd = new FormData();
    fd.set('name', name);
    fd.set('email', email);
    fd.set('phone', (form.querySelector('[name="phone"]') as HTMLInputElement).value.trim());
    fd.set('role', selectedRole);
    fd.set('address', addressInput.value.trim());
    fd.set('description', description);
    fd.set('hearAbout', (form.querySelector('[name="hearAbout"]') as HTMLInputElement).value.trim());
    fd.set('hp', (form.querySelector('#cf-hp') as HTMLInputElement).value);
    fd.set('t', (form.querySelector('[name="t"]') as HTMLInputElement).value);
    files.forEach((f) => fd.append('files', f));

    submitBtn.disabled = true;
    const labelEl = submitBtn.querySelector('[data-label]');
    const originalLabel = labelEl?.textContent;
    if (labelEl) labelEl.textContent = 'Sending…';

    try {
      const res = await fetch('/api/enquiry', { method: 'POST', body: fd });
      if (!res.ok && res.status !== 202) throw new Error('send_failed');
      const data = await res.json().catch(() => ({}));
      showSuccess({
        firstName: name.split(/\s+/)[0] || '',
        fileCount: files.length,
        subject: data.subject || 'Enquiry received',
        urgent: !!data.urgent,
      });
    } catch {
      errorSummary.textContent =
        'Something went wrong sending the enquiry — call or email directly.';
      errorSummary.hidden = false;
      submitBtn.disabled = false;
      if (labelEl && originalLabel) labelEl.textContent = originalLabel;
    }
  });

  function showSuccess(opts: { firstName: string; fileCount: number; subject: string; urgent: boolean }) {
    form.hidden = true;
    successEl.hidden = false;
    (document.getElementById('cf-success-name') as HTMLElement).textContent = opts.firstName;
    (document.getElementById('cf-success-files') as HTMLElement).textContent = opts.fileCount
      ? `${opts.fileCount} ${opts.fileCount === 1 ? 'attachment' : 'attachments'} included with the enquiry.`
      : 'No attachments included — photos can always follow by email.';
    (document.getElementById('cf-subject-line') as HTMLElement).textContent = opts.subject;
    (document.getElementById('cf-urgent-tag') as HTMLElement).hidden = !opts.urgent;
  }

  document.getElementById('cf-reset')?.addEventListener('click', () => {
    form.reset();
    files = [];
    renderFiles();
    selectedRole = '';
    roleValue.value = '';
    roleWrap.querySelectorAll('.cf-role').forEach((b) => b.classList.remove('is-active'));
    successEl.hidden = true;
    form.hidden = false;
    submitBtn.disabled = false;
    const labelEl = submitBtn.querySelector('[data-label]');
    if (labelEl) labelEl.textContent = 'Send enquiry';
    errorSummary.hidden = true;
  });
</script>
