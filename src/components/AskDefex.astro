---
/**
 * AskDefex — site-wide floating assistant. FAB -> panel with a message list;
 * calls POST /api/ask (Anthropic Messages API server-side; the function
 * degrades gracefully to a fixed "not available" reply if unconfigured).
 */
import Icon from './Icon.astro';
---

<div id="askdefex-hint-wrap">
  <button id="askdefex-hint" class="askdefex-hint" hidden>Ask DEFEX</button>
</div>

<button id="askdefex-fab" class="askdefex-fab" aria-label="Ask DEFEX a question" aria-expanded="false">
  <span class="askdefex-fab__icon-open"><Icon name="message-circle" size={24} /></span>
  <span class="askdefex-fab__icon-close" hidden><Icon name="x" size={24} /></span>
</button>

<div id="askdefex-panel" class="askdefex-panel" role="dialog" aria-label="Ask DEFEX assistant" hidden>
  <div class="askdefex-panel__header">
    <img src="/brand/defex-mark-white.svg" alt="" class="askdefex-panel__mark" />
    <div class="askdefex-panel__heading">
      <p class="askdefex-panel__title">Ask DEFEX</p>
      <p class="askdefex-panel__subtitle">Answers from this website's information</p>
    </div>
    <button id="askdefex-close" class="askdefex-panel__close" aria-label="Close assistant">
      <Icon name="x" size={18} />
    </button>
  </div>
  <div id="askdefex-body" class="askdefex-panel__body">
    <div class="askdefex-row askdefex-row--bot">
      <div class="askdefex-bubble askdefex-bubble--bot">
        G&rsquo;day — ask me anything about DEFEX: services, how engagements run, the service area, or the
        DEFEX platform. If it&rsquo;s not covered on this site, I&rsquo;ll say so.
      </div>
    </div>
  </div>
  <div class="askdefex-panel__inputrow-wrap">
    <div class="askdefex-panel__inputrow">
      <input
        id="askdefex-input"
        type="text"
        placeholder="Ask about services, process, service area…"
        aria-label="Ask a question"
        class="askdefex-panel__input"
      />
      <button id="askdefex-send" class="askdefex-panel__send" aria-label="Send question">
        <Icon name="arrow-up" size={18} />
      </button>
    </div>
    <p class="askdefex-panel__disclaimer">
      AI answers based on defex.engineering content — not engineering advice. For anything specific, call
      <a href="tel:+61432261722">0432 261 722</a>.
    </p>
  </div>
</div>

<style>
  .askdefex-fab {
    position: fixed;
    right: 28px;
    bottom: 28px;
    z-index: 350;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: none;
    border-radius: 50%;
    background: var(--color-blue);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.4);
    transition: all 0.2s ease;
  }
  .askdefex-fab:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px);
  }
  .askdefex-fab:active {
    transform: scale(0.97);
  }

  #askdefex-hint-wrap {
    position: fixed;
    right: 96px;
    bottom: 40px;
    z-index: 350;
  }
  .askdefex-hint {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 8px 16px;
    border: none;
    border-radius: 999px;
    background: var(--color-navy);
    color: #fff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(16, 24, 40, 0.3);
    transition: all 0.2s ease;
  }
  .askdefex-hint:hover {
    background: var(--color-blue);
  }

  .askdefex-panel {
    position: fixed;
    right: 28px;
    bottom: 100px;
    z-index: 350;
    width: 388px;
    max-width: calc(100vw - 32px);
    height: min(540px, calc(100vh - 130px));
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-frame);
    box-shadow: 0 24px 64px rgba(16, 24, 40, 0.24);
    overflow: hidden;
  }
  .askdefex-panel__header {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--color-navy);
    padding: 16px 20px;
    flex-shrink: 0;
  }
  .askdefex-panel__mark {
    width: 26px;
    height: 26px;
    display: block;
  }
  .askdefex-panel__heading {
    flex: 1;
    min-width: 0;
  }
  .askdefex-panel__title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
  }
  .askdefex-panel__subtitle {
    margin: 0;
    font-size: 12px;
    color: var(--color-concrete, #c9cfd8);
  }
  .askdefex-panel__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: var(--color-concrete, #c9cfd8);
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.2s ease;
  }
  .askdefex-panel__close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }
  .askdefex-panel__body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--color-canvas);
  }
  .askdefex-row {
    display: flex;
  }
  .askdefex-row--user {
    justify-content: flex-end;
  }
  .askdefex-row--bot {
    justify-content: flex-start;
  }
  .askdefex-bubble {
    max-width: 82%;
    border-radius: 12px;
    padding: 10px 16px;
    font-size: 14px;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }
  .askdefex-bubble--user {
    background: var(--color-blue);
    color: #fff;
    border-radius: 12px 12px 4px 12px;
  }
  .askdefex-bubble--bot {
    background: #fff;
    color: var(--color-ink-body);
    border: 1px solid var(--color-border);
    border-radius: 12px 12px 12px 4px;
  }
  .askdefex-bubble--thinking {
    color: var(--color-grey);
  }
  .askdefex-panel__inputrow-wrap {
    border-top: 1px solid var(--color-border);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #fff;
    flex-shrink: 0;
  }
  .askdefex-panel__inputrow {
    display: flex;
    gap: 10px;
  }
  .askdefex-panel__input {
    flex: 1;
    min-height: 44px;
    padding: 10px 14px;
    font-size: 15px;
    font-family: inherit;
    color: var(--color-ink-body);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }
  .askdefex-panel__send {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    background: var(--color-blue);
    color: #fff;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .askdefex-panel__send:hover {
    background: var(--color-primary-hover);
  }
  .askdefex-panel__send:active {
    transform: scale(0.97);
  }
  .askdefex-panel__disclaimer {
    margin: 0;
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-grey);
  }
  .askdefex-panel__disclaimer a {
    color: var(--color-grey);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 480px) {
    .askdefex-panel {
      right: 16px;
      bottom: 84px;
    }
    .askdefex-fab {
      right: 16px;
      bottom: 16px;
    }
    #askdefex-hint-wrap {
      right: 78px;
      bottom: 28px;
    }
  }
</style>

<script>
  const fab = document.getElementById('askdefex-fab') as HTMLButtonElement;
  const panel = document.getElementById('askdefex-panel') as HTMLElement;
  const closeBtn = document.getElementById('askdefex-close') as HTMLButtonElement;
  const hintWrap = document.getElementById('askdefex-hint-wrap') as HTMLElement;
  const hint = document.getElementById('askdefex-hint') as HTMLButtonElement;
  const body = document.getElementById('askdefex-body') as HTMLElement;
  const input = document.getElementById('askdefex-input') as HTMLInputElement;
  const sendBtn = document.getElementById('askdefex-send') as HTMLButtonElement;
  const iconOpen = fab.querySelector('.askdefex-fab__icon-open') as HTMLElement;
  const iconClose = fab.querySelector('.askdefex-fab__icon-close') as HTMLElement;

  const SEEN_KEY = 'askdefex-seen';
  let busy = false;
  const history: Array<{ role: 'user' | 'assistant'; content: string }> = [];

  function setOpen(open: boolean) {
    panel.hidden = !open;
    fab.setAttribute('aria-expanded', String(open));
    iconOpen.hidden = open;
    iconClose.hidden = !open;
    if (open) {
      sessionStorage.setItem(SEEN_KEY, '1');
      hint.hidden = true;
      hintWrap.hidden = true;
      body.scrollTop = body.scrollHeight;
      input.focus();
    }
  }

  if (!sessionStorage.getItem(SEEN_KEY)) {
    hint.hidden = false;
  } else {
    hintWrap.hidden = true;
  }

  fab.addEventListener('click', () => setOpen(panel.hidden));
  hint.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));

  function addBubble(role: 'user' | 'assistant', text: string) {
    const row = document.createElement('div');
    row.className = `askdefex-row askdefex-row--${role === 'user' ? 'user' : 'bot'}`;
    const bubble = document.createElement('div');
    bubble.className = `askdefex-bubble askdefex-bubble--${role === 'user' ? 'user' : 'bot'}`;
    bubble.textContent = text;
    row.appendChild(bubble);
    body.appendChild(row);
    body.scrollTop = body.scrollHeight;
  }

  async function send() {
    const q = input.value.trim();
    if (!q || busy) return;
    input.value = '';
    addBubble('user', q);
    history.push({ role: 'user', content: q });
    busy = true;

    const thinkingRow = document.createElement('div');
    thinkingRow.className = 'askdefex-row askdefex-row--bot';
    thinkingRow.innerHTML =
      '<div class="askdefex-bubble askdefex-bubble--bot askdefex-bubble--thinking">Thinking…</div>';
    body.appendChild(thinkingRow);
    body.scrollTop = body.scrollHeight;

    let answer: string;
    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ question: q, history: history.slice(-8) }),
      });
      const data = await res.json().catch(() => ({}));
      answer =
        (data && typeof data.answer === 'string' && data.answer.trim()) ||
        'That is not covered on this site. Call 0432 261 722 or email andrew@defex.engineering.';
    } catch {
      answer = 'Something went wrong answering that. Call 0432 261 722 or email andrew@defex.engineering.';
    }

    thinkingRow.remove();
    addBubble('assistant', answer);
    history.push({ role: 'assistant', content: answer });
    busy = false;
  }

  sendBtn.addEventListener('click', send);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') send();
  });
</script>
