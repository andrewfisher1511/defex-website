---
/**
 * SectionHeading — H2 for section headers. Navy on light, white on dark.
 * Marketing display weight is 300 by default (the tagline overrides to 600
 * at its own call site).
 */
interface Props {
  tone?: 'light' | 'dark';
  weight?: 'light' | 'regular' | 'semibold';
  class?: string;
  id?: string;
}
const {
  tone = 'light',
  weight = 'regular',
  class: className = '',
  id,
} = Astro.props;

const color = tone === 'dark' ? 'text-white' : 'text-navy';
const weights: Record<string, string> = {
  light: 'font-light',
  regular: 'font-normal',
  semibold: 'font-semibold',
};
---

<h2
  id={id}
  class={`text-3xl md:text-4xl ${weights[weight]} tracking-[-0.02em] ${color} ${className}`}
>
  <slot />
</h2>
