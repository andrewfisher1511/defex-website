---
/**
 * Reveal — marks children for the shared IntersectionObserver in Base.astro
 * (fade + 24px slide-up, fired once). `delay` in ms for section stagger.
 */
interface Props {
  as?: string;
  delay?: number;
  class?: string;
}
const { as: Tag = 'div', delay = 0, class: className = '' } = Astro.props;
---

<Tag data-reveal data-delay={delay} class={className}>
  <slot />
</Tag>
