---
/**
 * Button — renders as <a> when `href` is set, otherwise <button>.
 * Variants: primary (blue fill), outline (1px current colour), ghost (white on dark).
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost';
  type?: 'button' | 'submit';
  class?: string;
  id?: string;
  ariaLabel?: string;
  external?: boolean;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  class: className = '',
  id,
  ariaLabel,
  external = false,
} = Astro.props;

const base =
  'btn btn-press inline-flex items-center justify-center gap-2 min-h-11 px-5 rounded-button text-base font-medium leading-none text-center no-underline cursor-pointer select-none';

const variants: Record<string, string> = {
  primary: 'bg-blue text-white border border-transparent hover:bg-primary-hover',
  outline: 'bg-transparent text-navy border border-current hover:bg-blueprint',
  ghost: 'bg-transparent text-white border border-concrete/70 hover:bg-white/10',
};

const cls = `${base} ${variants[variant]} ${className}`;
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

{
  href ? (
    <a href={href} class={cls} id={id} aria-label={ariaLabel} rel={rel} target={target}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} id={id} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
