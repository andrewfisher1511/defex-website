---
/**
 * CredentialStrip — three plain blueprint-tint cells: credentials + the two
 * NSW registrations. Sourced from site.json (principal).
 */
import { site } from '../lib/site.ts';

const cells = [site.principal.credentials, ...site.principal.registrations];
---

<div class="grid gap-3 sm:grid-cols-3">
  {
    cells.map((cell) => (
      <div class="rounded-card border border-blueprint-border bg-blueprint px-5 py-5 text-center text-base font-medium text-navy">
        {cell}
      </div>
    ))
  }
</div>
