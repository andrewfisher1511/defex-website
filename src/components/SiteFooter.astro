---
/**
 * SiteFooter — Canvas surface, 1px top border. 3-col grid (lockup+contact+
 * socials / site links / practice text+capability link), credentials row.
 */
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import SocialIcon from './SocialIcon.astro';
import { site, currentYear } from '../lib/site.ts';

const nav = [
  { label: 'Services', href: '/services' },
  { label: 'Projects', href: '/projects' },
  { label: 'DEFEX App', href: '/defex-app' },
  { label: 'About', href: '/about' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Brand markSize={44} />
        <p class="site-footer__tagline">{site.tagline}</p>
        <p class="site-footer__contact">
          <a href={site.phoneHref}>{site.phone}</a>
          <span>·</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <div class="site-footer__social">
          <a href={site.social.linkedin} target="_blank" rel="noopener" aria-label="DEFEX on LinkedIn" class="site-footer__social-btn">
            <SocialIcon name="linkedin" />
          </a>
          <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="DEFEX on Facebook" class="site-footer__social-btn">
            <SocialIcon name="facebook" />
          </a>
          <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="DEFEX on Instagram" class="site-footer__social-btn">
            <SocialIcon name="instagram" />
          </a>
        </div>
      </div>

      <nav aria-label="Footer">
        <p class="site-footer__label">SITE</p>
        <div class="site-footer__links">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </nav>

      <div>
        <p class="site-footer__label">PRACTICE</p>
        <p class="site-footer__practice">
          Remedial consulting engineers.<br />{site.serviceArea}.
        </p>
        <a
          href={site.capabilityStatementHref ?? '#'}
          title="Attach the capability statement PDF"
          class="site-footer__capability"
        >
          <Icon name="file-down" size={16} /> Capability statement (PDF)
        </a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__credentials">{site.credentialLine}</p>
      <p class="site-footer__copy">
        <span>© {currentYear} DEFEX Engineering</span>
        <a href="/privacy">Privacy</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-canvas);
    border-top: 1px solid var(--color-border);
    padding: 72px var(--site-gutter) 40px;
  }
  .site-footer__inner {
    max-width: var(--container-site);
    margin: 0 auto;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr;
    gap: 64px;
    padding-bottom: 48px;
  }
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }
  .site-footer__tagline {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-navy);
  }
  .site-footer__contact {
    margin: 0;
    font-size: 14px;
    color: var(--color-steel);
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .site-footer__contact a {
    color: var(--color-steel);
    font-variant-numeric: tabular-nums;
  }
  .site-footer__contact a:hover {
    color: var(--color-blue);
  }
  .site-footer__social {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }
  .site-footer__social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-steel);
    background: #fff;
    transition: all 0.2s ease;
  }
  .site-footer__social-btn:hover {
    color: var(--color-blue);
    border-color: var(--color-blueprint-border);
    background: var(--color-blueprint);
  }
  .site-footer__label {
    margin: 0 0 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--color-grey);
  }
  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .site-footer__links a {
    font-size: 14px;
    color: var(--color-ink-muted);
  }
  .site-footer__links a:hover {
    color: var(--color-blue);
  }
  .site-footer__practice {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-steel);
  }
  .site-footer__capability {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-blue);
    min-height: 44px;
  }
  .site-footer__capability:hover {
    color: var(--color-primary-hover);
  }
  .site-footer__bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .site-footer__credentials {
    margin: 0;
    font-size: 13px;
    color: var(--color-grey);
  }
  .site-footer__copy {
    margin: 0;
    font-size: 13px;
    color: var(--color-grey);
    display: flex;
    gap: 16px;
    align-items: center;
    white-space: nowrap;
  }
  .site-footer__copy a {
    color: var(--color-grey);
  }
  .site-footer__copy a:hover {
    color: var(--color-blue);
  }

  @media (max-width: 899px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
