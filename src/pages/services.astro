---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Reveal from '../components/Reveal.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Services — DEFEX Engineering"
  description="Defect investigation, remedial and declared designs, specifications and tender, AS 4000 superintendency, expert reporting, façade and waterproofing assessment."
  ogImage="services"
>
  <PageHeader
    variant="navy"
    watermark
    eyebrow="SERVICES"
    heading="Remedial engineering, end to end."
    headingSize={76}
    lede="DEFEX provides the consulting spine of a remedial project: establishing what is wrong, designing the fix, and administering the contract that delivers it. Engage one service or the full sequence."
    padBottom={104}
  />

  <!-- Service list -->
  <section class="service-list">
    <div class="service-list__inner">
      <ol class="service-list__ol" data-scroll-track>
        <span class="service-list__rail" aria-hidden="true"></span>
        <span class="service-list__fill" data-scroll-fill data-mode="height" data-focal="0.72" aria-hidden="true"></span>
        {
          services.map((s) => (
            <li id={s.data.slug} class="service-list__item" data-reveal>
              <span class="service-list__num">{String(s.data.order).padStart(2, '0')}</span>
              <div>
                <h2 class="service-list__title">{s.data.title}</h2>
                <p class="service-list__body">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <aside class="service-rail" data-reveal data-delay="150">
        <p class="service-rail__label">ON THIS PAGE</p>
        <nav class="service-rail__links" aria-label="On this page">
          {
            services.map((s) => (
              <a href={`#${s.data.slug}`} data-rail-link={s.data.slug}>
                {s.data.title}
              </a>
            ))
          }
        </nav>
      </aside>
    </div>
  </section>

  <!-- Engagement timeline -->
  <section class="timeline">
    <div class="timeline__inner">
      <Reveal><Eyebrow>PROCESS</Eyebrow></Reveal>
      <Reveal delay={80}><h2 class="timeline__heading">How engagements run</h2></Reveal>
      <div class="timeline__grid" data-scroll-track>
        <span class="timeline__rail" aria-hidden="true"></span>
        <span
          class="timeline__fill"
          data-scroll-fill
          data-mode="width"
          data-focal="0.8"
          data-extra="200"
          aria-hidden="true"
        ></span>
        <div class="timeline__step" data-reveal>
          <span class="timeline__dot" aria-hidden="true"></span>
          <span class="timeline__num">01</span>
          <h3 class="timeline__title">Contact</h3>
          <p class="timeline__desc">Describe the building and the symptoms.</p>
        </div>
        <div class="timeline__step" data-reveal data-delay="80">
          <span class="timeline__dot" aria-hidden="true"></span>
          <span class="timeline__num">02</span>
          <h3 class="timeline__title">Proposal</h3>
          <p class="timeline__desc">A written scope and fee, in plain terms.</p>
        </div>
        <div class="timeline__step" data-reveal data-delay="160">
          <span class="timeline__dot" aria-hidden="true"></span>
          <span class="timeline__num">03</span>
          <h3 class="timeline__title">Investigation and reporting</h3>
          <p class="timeline__desc">Photo-evidenced, standards-keyed.</p>
        </div>
        <div class="timeline__step" data-reveal data-delay="240">
          <span class="timeline__dot" aria-hidden="true"></span>
          <span class="timeline__num">04</span>
          <h3 class="timeline__title">Design and delivery</h3>
          <p class="timeline__desc">Where rectification proceeds, through to completion.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Not sure which service you need?"
    body="Describe the symptoms — the sequence follows from the diagnosis."
    buttonLabel="Discuss a defect"
    buttonHref="/contact"
  />
</Base>

<style>
  .service-list {
    background: #fff;
    padding: 112px var(--site-gutter);
  }
  .service-list__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 96px;
    align-items: start;
  }
  .service-list__ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 64px;
    position: relative;
  }
  .service-list__rail {
    position: absolute;
    left: 24px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--color-border);
  }
  .service-list__fill {
    position: absolute;
    left: 24px;
    top: 8px;
    width: 2px;
    height: 0%;
    max-height: calc(100% - 16px);
    background: var(--color-blue);
  }
  .service-list__item {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    padding: 56px 0;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 104px;
  }
  .service-list__item:last-child {
    border-bottom: none;
  }
  .service-list__num {
    font-size: 64px;
    font-weight: 300;
    line-height: 1;
    color: var(--color-blue);
    font-variant-numeric: tabular-nums;
  }
  .service-list__title {
    margin: 0 0 16px;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  .service-list__body {
    margin: 0;
    max-width: 68ch;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-ink-body);
    text-wrap: pretty;
  }

  .service-rail {
    position: sticky;
    top: 104px;
    border-left: 2px solid var(--color-border);
    padding-left: 24px;
  }
  .service-rail__label {
    margin: 0 0 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--color-grey);
  }
  .service-rail__links {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .service-rail__links a {
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }
  .service-rail__links a:hover,
  .service-rail__links a.is-active {
    color: var(--color-blue);
  }

  .timeline {
    background: var(--color-canvas);
    border-top: 1px solid var(--color-border);
    padding: 112px var(--site-gutter);
  }
  .timeline__inner {
    max-width: var(--container-site);
    margin: 0 auto;
  }
  .timeline__heading {
    margin: 0 0 64px;
    font-size: 37px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  .timeline__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding-top: 40px;
  }
  .timeline__rail {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    height: 2px;
    background: var(--color-border);
  }
  .timeline__fill {
    position: absolute;
    top: 8px;
    left: 8px;
    height: 2px;
    width: 0%;
    max-width: calc(100% - 16px);
    background: var(--color-blue);
  }
  .timeline__step {
    position: relative;
  }
  .timeline__dot {
    position: absolute;
    top: -37px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-blue);
    border: 2px solid var(--color-canvas);
  }
  .timeline__num {
    display: block;
    font-size: 40px;
    font-weight: 300;
    color: var(--color-blue);
    margin-bottom: 12px;
    font-variant-numeric: tabular-nums;
  }
  .timeline__title {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
    color: var(--color-navy);
  }
  .timeline__desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-steel);
  }

  @media (max-width: 1100px) {
    .service-list__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .service-rail {
      position: static;
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--color-border);
      padding-top: 20px;
    }
    .service-rail__links {
      flex-direction: row;
      overflow-x: auto;
      gap: 10px;
      padding-bottom: 4px;
    }
    .service-rail__links a {
      flex-shrink: 0;
      white-space: nowrap;
      padding: 8px 14px;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: #fff;
    }
  }
  @media (max-width: 899px) {
    .service-list,
    .timeline {
      padding: 64px var(--site-gutter);
    }
    .service-list__ol {
      padding-left: 0;
    }
    .service-list__rail,
    .service-list__fill {
      display: none;
    }
    .service-list__item {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 20px;
    }
    .timeline__grid {
      grid-template-columns: 1fr;
      gap: 44px;
      padding-top: 0;
    }
    .timeline__rail,
    .timeline__fill {
      top: 8px;
      bottom: 8px;
      left: 8px;
      right: auto;
      width: 2px;
      height: auto;
    }
    .timeline__fill {
      width: 2px;
      height: 0%;
    }
    .timeline__dot {
      top: 0;
    }
    .timeline__step {
      padding-left: 40px;
    }
  }
</style>

<script>
  const railLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'));
  const sections = railLinks
    .map((l) => document.getElementById(l.dataset.railLink || ''))
    .filter((el): el is HTMLElement => el !== null);

  if (railLinks.length && 'IntersectionObserver' in window) {
    const setActive = (id: string) => {
      railLinks.forEach((l) => l.classList.toggle('is-active', l.dataset.railLink === id));
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]?.target.id) setActive(visible[0].target.id);
      },
      { rootMargin: '-104px 0px -60% 0px', threshold: 0 }
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
