---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../lib/site.ts';
import { getProjectImage } from '../../lib/images.ts';

const posts = (await getCollection('posts')).sort((a, b) => a.data.order - b.data.order);
const cards = await Promise.all(
  posts.map(async (p) => {
    const img = await getImage({ src: getProjectImage(p.data.image), width: 640, format: 'webp' });
    return { entry: p, img: img.src };
  })
);

const dateFmt = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Blog — DEFEX Engineering"
  description="Short, practical writing on defects, remediation and contract delivery — from DEFEX Engineering."
  ogImage="blog"
>
  <header class="blog-header">
    <div class="blog-header__inner">
      <div>
        <div data-hero-seq="0" class="blog-header__eyebrow">
          <span class="blog-header__rule"></span>
          <span class="blog-header__eyebrow-label">BLOG</span>
        </div>
        <h1 data-hero-seq="1" class="blog-header__heading">Notes from site.</h1>
        <p data-hero-seq="2" class="blog-header__lede">
          Short, practical writing on defects, remediation and contract delivery — the web versions of
          posts first shared on LinkedIn.
        </p>
      </div>
      <a data-hero-seq="3" href={site.social.linkedin} target="_blank" rel="noopener" class="blog-header__follow">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
        Follow on LinkedIn
      </a>
    </div>
  </header>

  <section class="post-grid">
    <div class="post-grid__inner">
      {
        cards.map(({ entry, img }, i) => (
          <a href={`/blog/${entry.data.slug}`} class="post-card" data-reveal data-delay={i * 60}>
            <img src={img} alt="" width="640" height="360" class="post-card__img" />
            <span class="post-card__content">
              <span class="post-card__meta">
                <span>{entry.data.category.toUpperCase()}</span>
                <span class="post-card__dot">·</span>
                <span class="post-card__date">{dateFmt.format(entry.data.date)}</span>
              </span>
              <span class="post-card__title">{entry.data.title}</span>
              <span class="post-card__excerpt">{entry.data.excerpt}</span>
              <span class="post-card__read">
                Read post <Icon name="arrow-right" size={15} />
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .blog-header {
    background: #fff;
    padding: 216px var(--site-gutter) 72px;
    border-bottom: 1px solid var(--color-border);
  }
  .blog-header__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    flex-wrap: wrap;
  }
  .blog-header__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }
  .blog-header__rule {
    display: block;
    width: 48px;
    height: 2px;
    background: var(--color-blue);
  }
  .blog-header__eyebrow-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--color-steel);
  }
  .blog-header__heading {
    margin: 0 0 28px;
    max-width: 900px;
    font-size: 76px;
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-navy);
    text-wrap: balance;
  }
  .blog-header__lede {
    margin: 0;
    max-width: 600px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }
  .blog-header__follow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 12px 22px;
    background: var(--color-blueprint);
    border: 1px solid var(--color-blueprint-border);
    color: var(--color-blue);
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .blog-header__follow:hover {
    background: var(--color-blue);
    color: #fff;
    border-color: var(--color-blue);
  }

  .post-grid {
    background: var(--color-canvas);
    padding: 96px var(--site-gutter) 120px;
  }
  .post-grid__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    text-align: left;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-frame);
    overflow: hidden;
    color: var(--color-ink-body);
    transition: all 0.2s ease;
  }
  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.12);
    border-color: var(--color-blueprint-border);
  }
  .post-card__img {
    width: 100%;
    height: 210px;
    object-fit: cover;
    display: block;
  }
  .post-card__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
  }
  .post-card__meta {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-blueprint-ink);
  }
  .post-card__dot {
    color: var(--color-concrete, #c9cfd8);
  }
  .post-card__date {
    font-variant-numeric: tabular-nums;
  }
  .post-card__title {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-navy);
  }
  .post-card__excerpt {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-steel);
  }
  .post-card__read {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-blue);
    margin-top: 4px;
  }

  @media (max-width: 1100px) {
    .post-grid__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 899px) {
    .blog-header {
      padding: 128px var(--site-gutter) 48px;
    }
    .post-grid {
      padding: 56px var(--site-gutter) 72px;
    }
    .post-grid__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
