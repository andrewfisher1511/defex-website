---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../lib/site.ts';
import { getProjectImage } from '../../lib/images.ts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return Promise.all(
    posts.map(async (entry) => {
      const img = await getImage({ src: getProjectImage(entry.data.image), width: 1200, format: 'webp' });
      return { params: { slug: entry.data.slug }, props: { entry, imgSrc: img.src } };
    })
  );
}

const { entry, imgSrc } = Astro.props;
const { Content } = await render(entry);

const dateFmt = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title={`${entry.data.title} — DEFEX Engineering`}
  description={entry.data.excerpt}
  ogImage="blog"
>
  <article class="post">
    <div class="post__inner">
      <a href="/blog" class="post__back">
        <Icon name="arrow-left" size={16} /> All posts
      </a>
      <p class="post__meta">
        <span>{entry.data.category.toUpperCase()}</span>
        <span class="post__dot">·</span>
        <span class="post__date">{dateFmt.format(entry.data.date)}</span>
        <span class="post__dot">·</span>
        <span>{entry.data.author.toUpperCase()}</span>
      </p>
      <h1 class="post__title">{entry.data.title}</h1>
      <img src={imgSrc} alt="" width="1200" height="500" class="post__hero" />
      <div class="post__body">
        <Content />
      </div>
      <div class="post__footer">
        <a href={site.social.linkedin} target="_blank" rel="noopener" class="post__linkedin">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
          Discuss this post on LinkedIn
        </a>
        <span class="post__dot">·</span>
        <a href="/contact" class="post__cta">
          {entry.data.ctaLabel} <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </article>
</Base>

<style>
  .post {
    background: #fff;
    padding: 160px var(--site-gutter) 120px;
  }
  .post__inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .post__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-blue);
    margin-bottom: 40px;
  }
  .post__back:hover {
    color: var(--color-primary-hover);
  }
  .post__meta {
    margin: 0 0 20px;
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-blueprint-ink);
  }
  .post__dot {
    color: var(--color-concrete, #c9cfd8);
  }
  .post__date {
    font-variant-numeric: tabular-nums;
  }
  .post__title {
    margin: 0 0 32px;
    font-size: 46px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--color-navy);
    text-wrap: balance;
  }
  .post__hero {
    width: 100%;
    height: 380px;
    object-fit: cover;
    border-radius: var(--radius-frame);
    display: block;
    margin-bottom: 40px;
  }
  .post__body :global(p) {
    margin: 0 0 24px;
    font-size: 17px;
    line-height: 1.8;
    color: var(--color-ink-body);
    text-wrap: pretty;
  }
  .post__footer {
    display: flex;
    align-items: center;
    gap: 16px;
    border-top: 1px solid var(--color-border);
    padding-top: 28px;
    margin-top: 40px;
    flex-wrap: wrap;
  }
  .post__linkedin,
  .post__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-blue);
    min-height: 44px;
  }
  .post__linkedin:hover,
  .post__cta:hover {
    color: var(--color-primary-hover);
  }

  @media (max-width: 899px) {
    .post {
      padding: 128px var(--site-gutter) 72px;
    }
    .post__title {
      font-size: 34px;
    }
    .post__hero {
      height: 240px;
    }
  }
</style>
