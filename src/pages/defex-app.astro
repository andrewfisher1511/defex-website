---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Reveal from '../components/Reveal.astro';
import Icon from '../components/Icon.astro';
import ScreenshotFrame from '../components/ScreenshotFrame.astro';
import { site } from '../lib/site.ts';
import { getScreenshot } from '../lib/images.ts';

const pipeline = [
  {
    icon: 'clipboard-check' as const,
    title: 'Inspections',
    body: 'Site capture with photographs pinned to defect, location and inspection.',
  },
  {
    icon: 'crosshair' as const,
    title: 'Defect registers',
    body: 'Every defect tracked from discovery to rectification, keyed to standards.',
  },
  {
    icon: 'receipt' as const,
    title: 'Claims and contract admin',
    body: 'AS 4000 progress claims, variations and EOTs assessed on one sheet.',
  },
  {
    icon: 'globe' as const,
    title: 'Client and builder portal',
    body: 'Clients and builders log in to the projects they are connected to — dashboards, documents, programs and progress.',
  },
];
---

<Base
  title="The DEFEX Platform — DEFEX Engineering"
  description="DEFEX is our in-house field-to-issued-document platform — the reason reports are fast, photo-evidenced and standards-keyed. Client and builder login included with every engagement."
  ogImage="defex-app"
>
  <header class="app-header">
    <div class="app-header__grid" aria-hidden="true"></div>
    <div class="app-header__inner">
      <div data-hero-seq="0" class="app-header__eyebrow">
        <span class="app-header__rule"></span>
        <span class="app-header__eyebrow-label">THE PLATFORM</span>
      </div>
      <h1 data-hero-seq="1" class="app-header__heading">DEFEX — field to issued document.</h1>
      <p data-hero-seq="2" class="app-header__lede">
        DEFEX is the in-house platform this practice is built on. It exists for one reason: so that what
        is observed on site becomes a defensible, standards-keyed document without anything being lost or
        retyped in between.
      </p>
      <p data-hero-seq="3" class="app-header__note">
        DEFEX is not for sale and has no pricing page. It is how DEFEX Engineering works — and, for
        clients and builders, it is the login door to the projects they are connected to.
      </p>
      <div data-hero-seq="4" class="app-header__actions">
        <a href={site.appUrl} target="_blank" rel="noopener" class="btn-blue">
          <Icon name="lock" size={16} /> Log in to DEFEX
        </a>
        <span class="app-header__hint">Approved users only — sign-in verified with an authenticator app.</span>
      </div>
      <div data-hero-seq="5" class="app-header__shot">
        <ScreenshotFrame
          image={getScreenshot('defex-command-board')}
          alt="DEFEX Command project board"
          label="DEFEX Command — project board"
          displayWidth={1160}
          loading="eager"
          glow
        />
      </div>
    </div>
  </header>

  <!-- Command -->
  <section class="app-section">
    <div class="app-section__inner">
      <div>
        <Reveal><Eyebrow>COMMAND</Eyebrow></Reveal>
        <Reveal delay={60}><h2 class="app-section__heading">One board, every engagement</h2></Reveal>
        <Reveal delay={120}>
          <p class="app-section__body">
            Every job sits on a single stage-grouped board — from first request through fee, decision,
            inspection and issued report. Timelines show exactly where each engagement is and what is due
            next.
          </p>
        </Reveal>
        <Reveal delay={160}>
          <p class="app-section__body">
            Nothing waits in an inbox: fee reminders, stale jobs and due documents surface themselves.
          </p>
        </Reveal>
      </div>
      <Reveal delay={100}>
        <ScreenshotFrame
          image={getScreenshot('defex-timesheets')}
          alt="DEFEX Timesheets — weekly time recording"
          label="DEFEX Timesheets"
          displayWidth={900}
        />
      </Reveal>
    </div>
  </section>

  <!-- Capture -->
  <section class="app-section is-canvas">
    <div class="app-section__inner is-reversed">
      <Reveal delay={100}>
        <ScreenshotFrame
          image={getScreenshot('defex-capture-settings')}
          alt="DEFEX Capture settings"
          label="DEFEX Capture — settings"
          displayWidth={900}
        />
      </Reveal>
      <div>
        <Reveal><Eyebrow>CAPTURE</Eyebrow></Reveal>
        <Reveal delay={60}><h2 class="app-section__heading">Capture on site, keep the chain of evidence</h2></Reveal>
        <Reveal delay={120}>
          <p class="app-section__body">
            Defects are recorded in the field with photographs attached at the point of observation.
            Originals are retained at full resolution; every image stays tied to the defect, location and
            inspection it evidences.
          </p>
        </Reveal>
        <Reveal delay={160}>
          <p class="app-section__body">
            Time and activity are captured the same way — suggested from the day's real work, confirmed by
            the engineer, never invented.
          </p>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="app-section">
    <div class="app-section__inner is-single">
      <Reveal><Eyebrow>FROM SITE TO DOCUMENT</Eyebrow></Reveal>
      <Reveal delay={60}><h2 class="app-section__heading app-section__heading--wide">What flows through DEFEX</h2></Reveal>
      <div class="pipeline-grid">
        {
          pipeline.map((card, i) => (
            <div class="pipeline-card" data-reveal data-delay={i * 60}>
              <Icon name={card.icon} size={24} class="pipeline-card__icon" />
              <span class="pipeline-card__title">{card.title}</span>
              <span class="pipeline-card__body">{card.body}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    heading="Engage the practice, get the platform."
    body="Every engagement runs through DEFEX — no extra cost, no software decision to make."
    buttonLabel="Discuss a defect"
    buttonHref="/contact"
  />
</Base>

<style>
  .app-header {
    position: relative;
    background: var(--color-navy);
    padding: 216px var(--site-gutter) 0;
    overflow: hidden;
  }
  .app-header__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
  }
  .app-header__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    position: relative;
  }
  .app-header__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }
  .app-header__rule {
    display: block;
    width: 48px;
    height: 2px;
    background: var(--color-blue);
  }
  .app-header__eyebrow-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--color-concrete, #c9cfd8);
    white-space: nowrap;
  }
  .app-header__heading {
    margin: 0 0 28px;
    max-width: 1100px;
    font-size: 76px;
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #fff;
    text-wrap: balance;
  }
  .app-header__lede {
    margin: 0 0 16px;
    max-width: 640px;
    font-size: 18px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
    text-wrap: pretty;
  }
  .app-header__note {
    margin: 0 0 40px;
    max-width: 640px;
    font-size: 16px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.6);
    text-wrap: pretty;
  }
  .app-header__actions {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 64px;
    flex-wrap: wrap;
  }
  .app-header__hint {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
  }
  .app-header__shot {
    margin: 0 auto;
    max-width: 1160px;
  }

  .app-section {
    background: #fff;
    padding: 120px var(--site-gutter);
    border-bottom: 1px solid var(--color-border);
  }
  .app-section.is-canvas {
    background: var(--color-canvas);
  }
  .app-section__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 440px minmax(0, 1fr);
    gap: 96px;
    align-items: center;
  }
  .app-section__inner.is-reversed {
    grid-template-columns: minmax(0, 1fr) 440px;
  }
  .app-section__inner.is-single {
    display: block;
  }
  .app-section__heading {
    margin: 24px 0;
    font-size: 37px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-navy);
    text-wrap: balance;
  }
  .app-section__heading--wide {
    margin-bottom: 56px;
  }
  .app-section__body {
    margin: 0 0 20px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }
  .app-section__body:last-child {
    margin-bottom: 0;
  }

  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .pipeline-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-frame);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: all 0.2s ease;
  }
  .pipeline-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.12);
    border-color: var(--color-blueprint-border);
  }
  .pipeline-card__icon {
    color: var(--color-blue);
  }
  .pipeline-card__title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-navy);
  }
  .pipeline-card__body {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-steel);
  }

  @media (max-width: 1100px) {
    .app-section__inner,
    .app-section__inner.is-reversed {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .pipeline-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 899px) {
    .app-header {
      padding-top: 128px;
    }
    .app-header__heading {
      font-size: clamp(40px, 11vw, 76px);
    }
    .app-section {
      padding: 64px var(--site-gutter);
    }
    .pipeline-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
