---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site.ts';
---

<Base
  title="Contact — DEFEX Engineering"
  description="Discuss a building defect with a registered remedial engineer. Sydney metro, occasionally Greater NSW."
  ogImage="contact"
>
  <PageHeader
    variant="white"
    eyebrow="CONTACT"
    heading="Discuss a defect."
    headingSize={76}
    lede="Call or email directly, or send the details below. Engagements are accepted across Sydney metro and occasionally Greater NSW."
    padBottom={72}
  />

  <section class="contact-body">
    <div class="contact-body__inner">
      <aside class="contact-rail" data-reveal>
        <div>
          <p class="contact-rail__label">PHONE</p>
          <a href={site.phoneHref} class="contact-rail__phone">{site.phone}</a>
        </div>
        <div>
          <p class="contact-rail__label">EMAIL</p>
          <a href={`mailto:${site.email}`} class="contact-rail__email">{site.email}</a>
        </div>
        <div>
          <p class="contact-rail__label">SERVICE AREA</p>
          <p class="contact-rail__text">{site.serviceArea}.</p>
        </div>
        <div>
          <p class="contact-rail__label">HOURS</p>
          <p class="contact-rail__text">{site.hours.line1}<br />{site.hours.line2}</p>
        </div>
        <div class="contact-rail__tip">
          <Icon name="camera" size={20} />
          <p>Attachments help with an early read — photos of the symptom, previous reports, strata minutes or quotes.</p>
        </div>
        <div class="contact-rail__map">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(site.location.mapQuery)}&output=embed`}
            title={`DEFEX Engineering — based in ${site.location.suburb}`}
            loading="lazy"
          ></iframe>
          <p>Based in {site.location.suburb.replace(' NSW 2227', ', NSW')} — serving Sydney metro.</p>
        </div>
      </aside>

      <ContactForm />
    </div>
  </section>
</Base>

<style>
  .contact-body {
    background: var(--color-canvas);
    border-top: 1px solid var(--color-border);
    padding: 96px var(--site-gutter) 120px;
  }
  .contact-body__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 380px minmax(0, 1fr);
    gap: 96px;
    align-items: start;
  }
  .contact-rail {
    position: sticky;
    top: 104px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .contact-rail__label {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--color-grey);
  }
  .contact-rail__phone {
    font-size: 24px;
    font-weight: 300;
    color: var(--color-navy);
    font-variant-numeric: tabular-nums;
  }
  .contact-rail__phone:hover {
    color: var(--color-blue);
  }
  .contact-rail__email {
    font-size: 20px;
    font-weight: 300;
    color: var(--color-navy);
    word-break: break-word;
  }
  .contact-rail__email:hover {
    color: var(--color-blue);
  }
  .contact-rail__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
  .contact-rail__tip {
    background: var(--color-blueprint);
    border: 1px solid var(--color-blueprint-border);
    border-radius: var(--radius-card);
    padding: 20px 22px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .contact-rail__tip :global(svg) {
    color: var(--color-blue);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .contact-rail__tip p {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
  .contact-rail__map {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: #fff;
  }
  .contact-rail__map iframe {
    width: 100%;
    height: 220px;
    border: none;
    display: block;
  }
  .contact-rail__map p {
    margin: 0;
    padding: 12px 16px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-steel);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 1100px) {
    .contact-body__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .contact-rail {
      position: static;
    }
  }
  @media (max-width: 899px) {
    .contact-body {
      padding: 56px var(--site-gutter) 72px;
    }
  }
</style>
