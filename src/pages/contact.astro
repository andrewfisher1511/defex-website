---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import Reveal from '../components/Reveal.astro';
import { site } from '../lib/site.ts';
---

<Base
  title="Contact — DEFEX Engineering"
  description="Discuss a building defect with a registered remedial engineer. Sydney metro, occasionally Greater NSW."
  ogImage="contact"
>
  <section class="bg-canvas">
    <div class="mx-auto max-w-site px-[var(--site-gutter)] pt-16 md:pt-24">
      <PageHeader
        eyebrow="Contact"
        heading="Discuss a defect."
        lede="Call or email directly, or send the details below. Engagements are accepted across Sydney metro and occasionally Greater NSW."
      />
    </div>
  </section>

  <section class="bg-canvas">
    <div class="mx-auto max-w-site px-[var(--site-gutter)] pb-16 pt-10 md:pb-24 md:pt-14">
      <div class="grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
        <!-- Contact block -->
        <Reveal>
          <div class="flex flex-col gap-6">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.1em] text-steel">
                Phone
              </p>
              <a
                href={site.phoneHref}
                class="mt-1 inline-block text-xl font-medium text-navy hover:text-blue"
                >{site.phone}</a
              >
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.1em] text-steel">
                Email
              </p>
              <a
                href={`mailto:${site.email}`}
                class="mt-1 inline-block text-xl font-medium text-navy hover:text-blue"
                >{site.email}</a
              >
            </div>
            {
              site.postal && (
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.1em] text-steel">
                    Post
                  </p>
                  <p class="mt-1 text-base text-ink-body">{site.postal}</p>
                </div>
              )
            }
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.1em] text-steel">
                Service area
              </p>
              <p class="mt-1 text-base text-ink-body">{site.serviceArea}</p>
            </div>
          </div>
        </Reveal>

        <!-- Form -->
        <Reveal index={1}>
          <ContactForm />
        </Reveal>
      </div>
    </div>
  </section>
</Base>
