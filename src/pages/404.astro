---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base
  title="Page not found — DEFEX Engineering"
  description="The page you're after doesn't exist or has moved."
  ogImage="default"
>
  <section class="bg-canvas">
    <div
      class="mx-auto flex min-h-[60vh] max-w-site flex-col items-start justify-center px-[var(--site-gutter)] py-24"
    >
      <div class="max-w-[54ch]">
        <h1 class="text-4xl font-light tracking-[-0.02em] text-navy md:text-5xl">
          Page not found.
        </h1>
        <p class="mt-5 text-lg text-ink-muted">
          The page you're after doesn't exist or has moved.
        </p>
        <div class="mt-8">
          <Button href="/">Back to home</Button>
        </div>
      </div>
    </div>
  </section>
</Base>
