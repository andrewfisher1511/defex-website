---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Projects', href: '/projects' },
  { label: 'DEFEX App', href: '/defex-app' },
  { label: 'About', href: '/about' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];
---

<Base
  title="Page not found — DEFEX Engineering"
  description="This page isn't here. The engineer is."
  ogImage="default"
>
  <section class="notfound">
    <div class="notfound__inner">
      <p class="notfound__eyebrow">404</p>
      <h1 class="notfound__heading">This page isn&rsquo;t here. The engineer is.</h1>
      <p class="notfound__lede">Call, email, or pick up from one of the pages below.</p>
      <nav class="notfound__links" aria-label="Site">
        {
          links.map((l) => (
            <a href={l.href} class="notfound__link">
              {l.label} <Icon name="arrow-right" size={14} />
            </a>
          ))
        }
      </nav>
    </div>
  </section>
</Base>

<style>
  .notfound {
    background: var(--color-canvas);
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding: 160px var(--site-gutter) 96px;
  }
  .notfound__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    max-width: 60ch;
  }
  .notfound__eyebrow {
    margin: 0 0 20px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--color-blue);
  }
  .notfound__heading {
    margin: 0 0 20px;
    font-size: 46px;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-navy);
    text-wrap: balance;
  }
  .notfound__lede {
    margin: 0 0 40px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }
  .notfound__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .notfound__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-navy);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: all 0.2s ease;
  }
  .notfound__link:hover {
    border-color: var(--color-blue);
    color: var(--color-blue);
  }
</style>
