---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../lib/site.ts';

const cards = [
  {
    title: 'What is collected',
    body: [
      "When you contact DEFEX — by phone, email or the enquiry form — the practice collects what you provide: your name, contact details, your role in relation to the building, the building's address, a description of the issue, and any photographs or documents you attach.",
      'The website itself does not run advertising trackers and does not sell or trade personal information.',
    ],
  },
  {
    title: 'How it is used',
    body: [
      "Enquiry details are used to respond to you, to prepare a proposal, and — where an engagement proceeds — to deliver the work. Enquiries are recorded in the practice's project-management system so that nothing is lost between first contact and issued document.",
      'An automated service may be used to summarise an enquiry into an email subject line for the engineer. Enquiry content is not used to train models.',
    ],
  },
  {
    title: 'Who it is shared with',
    body: [
      'Personal information is not sold or disclosed for marketing. It is shared only as needed to deliver an engagement — for example with a contractor pricing rectification works, a strata manager coordinating access, or as required by law. Service providers that process data on the practice’s behalf (website hosting, email delivery, file storage) are engaged under their standard terms.',
    ],
  },
  {
    title: 'Storage and retention',
    body: [
      'Project records, including photographs and reports, are retained for as long as professional obligations require — engineering documentation typically must be kept for many years after completion. Enquiries that do not proceed are kept only as long as useful for responding, then archived or deleted.',
    ],
  },
  {
    title: 'Access and questions',
    body: [], // rendered specially below (contains live links)
  },
];
---

<Base
  title="Privacy — DEFEX Engineering"
  description="How DEFEX Engineering handles personal information, in plain terms."
  ogImage="default"
>
  <PageHeader
    variant="white"
    eyebrow="PRIVACY"
    heading="Privacy."
    headingSize={76}
    lede="How DEFEX Engineering handles personal information — in plain terms. Last updated July 2026."
    border
    padBottom={72}
  />

  <section class="privacy-body">
    <div class="privacy-body__inner">
      {
        cards.slice(0, -1).map((card) => (
          <div class="privacy-card" data-reveal>
            <h2 class="privacy-card__title">{card.title}</h2>
            {card.body.map((p) => (
              <p class="privacy-card__p">{p}</p>
            ))}
          </div>
        ))
      }
      <div class="privacy-card" data-reveal>
        <h2 class="privacy-card__title">Access and questions</h2>
        <p class="privacy-card__p">
          To access or correct your information, or to ask anything about this policy, contact{' '}
          <a href={`mailto:${site.email}`}>{site.email}</a> or call{' '}
          <a href={site.phoneHref}>{site.phone}</a>. You will deal with the engineer directly.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .privacy-body {
    background: var(--color-canvas);
    padding: 96px var(--site-gutter) 120px;
  }
  .privacy-body__inner {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .privacy-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-frame);
    padding: 40px 44px;
  }
  .privacy-card__title {
    margin: 0 0 16px;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  .privacy-card__p {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-ink-body);
    text-wrap: pretty;
  }
  .privacy-card__p:last-child {
    margin-bottom: 0;
  }
  .privacy-card__p a {
    font-weight: 600;
    color: var(--color-blue);
  }

  @media (max-width: 899px) {
    .privacy-body {
      padding: 56px var(--site-gutter) 72px;
    }
    .privacy-card {
      padding: 28px 24px;
    }
  }
</style>
