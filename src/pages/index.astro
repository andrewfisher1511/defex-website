---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Reveal from '../components/Reveal.astro';
import ScreenshotFrame from '../components/ScreenshotFrame.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../lib/site.ts';
import { getScreenshot } from '../lib/images.ts';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order
);

const whatWeDo = [
  {
    title: 'Investigate',
    line: 'Diagnostic inspection and testing that establishes cause, not just symptoms.',
    href: '/services#investigation',
  },
  {
    title: 'Design',
    line: 'Remedial designs and declared designs prepared under the Design and Building Practitioners Act.',
    href: '/services#remedial-design',
  },
  {
    title: 'Deliver',
    line: 'Specifications, tendering, superintendency and contract administration through to completion.',
    href: '/services#specification-tender',
  },
];

// JSON-LD (Home only, spec §9). Null facts omit their key entirely.
const structuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.tradingName,
  url: site.web,
  telephone: '+61 432 261 722',
  email: site.email,
  areaServed: 'Sydney, NSW, Australia',
  founder: {
    '@type': 'Person',
    name: site.principal.name,
    honorificSuffix: 'CPEng',
  },
  slogan: site.tagline,
};
---

<Base
  title="DEFEX Engineering — Remedial Consulting Engineers, Sydney"
  description="Forensic remedial engineering for Sydney strata, owners and managers. Defect investigation, remedial design, superintendency and expert reporting. Defects Resolved."
  ogImage="home"
  structuredData={structuredData}
>
  <Hero
    eyebrow="Remedial consulting engineers — Sydney"
    heading="Defects Resolved."
    support="Forensic remedial engineering for Sydney strata, owners and managers."
  />

  <!-- What we do -->
  <section class="bg-canvas">
    <div class="mx-auto max-w-site px-[var(--site-gutter)] py-16 md:py-28">
      <Reveal class="max-w-3xl">
        <Eyebrow>The practice</Eyebrow>
        <SectionHeading class="mt-3" weight="light"
          >From first inspection to issued certificate.</SectionHeading
        >
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">
          DEFEX Engineering investigates building defects, designs their
          rectification, and administers the contracts that deliver the work.
          The practice is led and carried out by one registered engineer — the
          person who inspects your building is the person who signs the report,
          prepares the design, and superintends the repair.
        </p>
      </Reveal>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          whatWeDo.map((card, i) => (
            <Reveal index={i}>
              <a
                href={card.href}
                class="group flex h-full flex-col rounded-card border border-border bg-surface p-6 transition-shadow hover:shadow-brand"
              >
                <h3 class="text-2xl font-semibold text-navy">{card.title}</h3>
                <p class="mt-3 text-base leading-relaxed text-ink-muted">
                  {card.line}
                </p>
                <span
                  aria-hidden="true"
                  class="mt-5 text-lg text-blue transition-transform group-hover:translate-x-1"
                  >→</span
                >
              </a>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services strip -->
  <section class="border-t border-border bg-surface">
    <div class="mx-auto max-w-site px-[var(--site-gutter)] py-16 md:py-28">
      <Reveal>
        <Eyebrow>Services</Eyebrow>
        <SectionHeading class="mt-3" weight="light"
          >Six things, done properly.</SectionHeading
        >
      </Reveal>
      <Reveal>
        <ul class="mt-10 grid gap-x-10 gap-y-4 sm:grid-cols-2">
          {
            services.map((s) => (
              <li class="border-b border-border">
                <a
                  href={`/services#${s.data.slug}`}
                  class="flex min-h-[52px] items-center justify-between gap-4 text-lg text-ink-body transition-colors hover:text-blue"
                >
                  <span>{s.data.title}</span>
                  <span aria-hidden="true" class="text-steel">→</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href="/services"
          class="mt-8 inline-block text-base font-medium text-blue hover:underline"
          >All services →</a
        >
      </Reveal>
    </div>
  </section>

  <!-- Platform (navy) -->
  <section class="bg-navy">
    <div class="mx-auto max-w-site px-[var(--site-gutter)] py-16 md:py-28">
      <div class="grid items-center gap-10 md:grid-cols-2 md:gap-16">
        <Reveal>
          <Eyebrow tone="dark">The DEFEX platform</Eyebrow>
          <h2
            class="mt-3 text-3xl font-light tracking-[-0.02em] text-white md:text-4xl"
          >
            Built by the engineer who uses it.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-concrete">
            Every DEFEX engagement runs on DEFEX — our in-house platform that
            carries a defect from site capture to issued document. Photographs
            stay tied to the defect they evidence, defects stay keyed to the
            Australian Standards they breach, and reports are assembled from the
            record rather than rewritten from memory. It is why the paperwork is
            fast, and why it holds up.
          </p>
          <a
            href="/defex-app"
            class="mt-6 inline-block text-base font-medium text-blue hover:underline"
            >About the platform →</a
          >
        </Reveal>
        <Reveal index={1}>
          <ScreenshotFrame
            image={getScreenshot('defex-command-board')}
            alt="DEFEX Command board showing project control across active engagements."
            onDark
            displayWidth={520}
          />
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Principal strip -->
  <section class="border-t border-border bg-canvas">
    <div class="mx-auto max-w-site px-[var(--site-gutter)] py-16 md:py-24">
      <Reveal class="max-w-3xl">
        <SectionHeading weight="light"
          >A registered practitioner, personally accountable.</SectionHeading
        >
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">
          DEFEX Engineering is led by Andrew Fisher — BEng(Civil), MIEAust,
          CPEng, NSW Registered Professional Engineer and NSW Registered Design
          Practitioner. Engagements are accepted across Sydney, and occasionally
          Greater NSW.
        </p>
        <a
          href="/about"
          class="mt-6 inline-block text-base font-medium text-blue hover:underline"
          >About Andrew →</a
        >
      </Reveal>
    </div>
  </section>

  <CtaBand
    heading="Have a defect that needs resolving?"
    body="Call or email to discuss the building, the symptoms, and the sensible next step."
    buttonLabel="Contact DEFEX"
    buttonHref="/contact"
  />
</Base>
