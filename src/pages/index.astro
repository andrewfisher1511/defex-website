---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Reveal from '../components/Reveal.astro';
import CredentialChip from '../components/CredentialChip.astro';
import DefectDiagnostics from '../components/DefectDiagnostics.astro';
import ScreenshotFrame from '../components/ScreenshotFrame.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site.ts';
import { getScreenshot } from '../lib/images.ts';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const structuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.tradingName,
  url: site.web,
  telephone: '+61 432 261 722',
  email: site.email,
  areaServed: 'Sydney, NSW, Australia',
  founder: {
    '@type': 'Person',
    name: site.principal.name,
    honorificSuffix: 'CPEng',
  },
  slogan: site.tagline,
};
---

<Base
  title="DEFEX Engineering — Remedial Consulting Engineers, Sydney"
  description="Forensic remedial engineering for Sydney strata, owners and managers. Defect investigation, remedial design, superintendency and expert reporting. Defects Resolved."
  ogImage="home"
  structuredData={structuredData}
>
  <Hero
    eyebrow="SYDNEY · REMEDIAL CONSULTING ENGINEERS"
    heading="Remedial engineering."
    sub="Defects resolved — investigated, designed and superintended by the engineer who signs."
    height={820}
    showScrollCue
  >
    <Fragment slot="buttons">
      <a href="/contact" class="btn-blue">Discuss a defect <Icon name="arrow-right" size={16} /></a>
      <a href="/services" class="btn-outline-onphoto">View services</a>
    </Fragment>
  </Hero>

  <!-- Practice strip -->
  <section class="practice-strip">
    <div class="practice-strip__inner">
      <div>
        <Reveal><Eyebrow>THE PRACTICE</Eyebrow></Reveal>
        <Reveal delay={80}>
          <p class="practice-strip__lead">
            A deliberately small Sydney practice — the engineer who inspects the building is the engineer
            who writes the report, prepares the design and superintends the works.
          </p>
        </Reveal>
        <Reveal delay={160}>
          <a href="/about" class="practice-strip__link">About the practice <Icon name="arrow-right" size={16} /></a>
        </Reveal>
      </div>
      <Reveal delay={120} class="practice-strip__chips">
        <CredentialChip icon="award" label={site.principal.credentials} />
        <CredentialChip icon="shield-check" label={site.principal.registrations[0]} />
        <CredentialChip icon="pencil-ruler" label={site.principal.registrations[1]} />
      </Reveal>
    </div>
  </section>

  <!-- Services grid -->
  <section class="services-grid">
    <div class="services-grid__inner">
      <Reveal><Eyebrow>SERVICES</Eyebrow></Reveal>
      <Reveal delay={60} class="services-grid__header">
        <h2 class="services-grid__heading">Remedial engineering, end to end</h2>
        <a href="/services" class="services-grid__all">All services <Icon name="arrow-right" size={16} /></a>
      </Reveal>
      <div class="services-grid__cards">
        {
          services.map((s, i) => (
            <a
              href={`/services#${s.data.slug}`}
              class="service-card"
              data-reveal
              data-delay={(i % 3) * 60}
            >
              <span class="service-card__num">{String(s.data.order).padStart(2, '0')}</span>
              <span class="service-card__title">{s.data.title}</span>
              <span class="service-card__summary">{s.data.summary}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <DefectDiagnostics />

  <!-- Platform teaser -->
  <section class="platform-teaser">
    <div class="platform-teaser__inner">
      <div>
        <Reveal><Eyebrow>THE PLATFORM</Eyebrow></Reveal>
        <Reveal delay={60}>
          <h2 class="platform-teaser__heading">Carried by DEFEX, field to issued document</h2>
        </Reveal>
        <Reveal delay={120}>
          <p class="platform-teaser__body">
            The in-house platform this practice is built on — every engagement runs from site capture to
            issued document without anything being lost or retyped in between.
          </p>
        </Reveal>
        <Reveal delay={160}>
          <a href="/defex-app" class="platform-teaser__link">See how DEFEX works <Icon name="arrow-right" size={16} /></a>
        </Reveal>
      </div>
      <Reveal delay={100}>
        <ScreenshotFrame
          image={getScreenshot('defex-command-board')}
          alt="DEFEX Command project board showing project control across active engagements."
          displayWidth={900}
        />
      </Reveal>
    </div>
  </section>

  <CtaBand heading="Talk to the engineer directly." contactLine buttonLabel="Contact DEFEX" buttonHref="/contact" />
</Base>

<style>
  .practice-strip {
    background: #fff;
    padding: 96px var(--site-gutter);
    border-bottom: 1px solid var(--color-border);
  }
  .practice-strip__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 460px;
    gap: 96px;
    align-items: center;
  }
  .practice-strip__lead {
    margin: 0 0 28px;
    max-width: 60ch;
    font-size: 26px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-navy);
    text-wrap: pretty;
  }
  .practice-strip__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-blue);
    min-height: 44px;
  }
  .practice-strip__link:hover {
    color: var(--color-primary-hover);
  }
  .practice-strip__chips {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .services-grid {
    background: var(--color-canvas);
    padding: 120px var(--site-gutter);
  }
  .services-grid__inner {
    max-width: var(--container-site);
    margin: 0 auto;
  }
  .services-grid__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin: 20px 0 56px;
    flex-wrap: wrap;
  }
  .services-grid__heading {
    margin: 0;
    font-size: 37px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  .services-grid__all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-blue);
    min-height: 44px;
    white-space: nowrap;
  }
  .services-grid__all:hover {
    color: var(--color-primary-hover);
  }
  .services-grid__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .service-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-frame);
    padding: 32px;
    color: var(--color-ink-body);
    transition: all 0.2s ease;
  }
  .service-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.12);
    border-color: var(--color-blueprint-border);
    color: var(--color-ink-body);
  }
  .service-card__num {
    font-size: 40px;
    font-weight: 300;
    line-height: 1;
    color: var(--color-blue);
    font-variant-numeric: tabular-nums;
  }
  .service-card__title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-navy);
  }
  .service-card__summary {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-steel);
  }

  .platform-teaser {
    background: #fff;
    padding: 120px var(--site-gutter);
    border-bottom: 1px solid var(--color-border);
  }
  .platform-teaser__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 440px minmax(0, 1fr);
    gap: 96px;
    align-items: center;
  }
  .platform-teaser__heading {
    margin: 24px 0;
    font-size: 37px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-navy);
    text-wrap: balance;
  }
  .platform-teaser__body {
    margin: 0 0 32px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }
  .platform-teaser__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-blue);
    min-height: 44px;
  }
  .platform-teaser__link:hover {
    color: var(--color-primary-hover);
  }

  @media (max-width: 1100px) {
    .practice-strip__inner,
    .platform-teaser__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .services-grid__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 899px) {
    .practice-strip,
    .services-grid,
    .platform-teaser {
      padding: 64px var(--site-gutter);
    }
    .services-grid__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
