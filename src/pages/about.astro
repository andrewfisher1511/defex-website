---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Reveal from '../components/Reveal.astro';
import CredentialChip from '../components/CredentialChip.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site.ts';

const steps = [
  { title: 'Contact', body: 'Describe the building and the symptoms.' },
  { title: 'Proposal', body: 'A written scope and fee, in plain terms.' },
  { title: 'Investigation and reporting', body: 'Photo-evidenced, standards-keyed.' },
  { title: 'Design and delivery', body: 'Where rectification proceeds, through to completion.' },
];
---

<Base
  title="About — DEFEX Engineering"
  description="A deliberately small Sydney remedial practice led by Andrew Fisher — CPEng, NSW Registered Professional Engineer and Registered Design Practitioner."
  ogImage="about"
>
  <Hero
    eyebrow="ABOUT"
    heading="A deliberately small practice."
    sub="Remedial consulting engineers. Sydney metro, occasionally Greater NSW."
    height={760}
    showScrollCue
  />

  <!-- The practice -->
  <section class="practice" id="practice">
    <div class="practice__inner">
      <div>
        <Reveal class="practice__eyebrow-wrap"><Eyebrow>THE PRACTICE</Eyebrow></Reveal>
        <Reveal delay={80}>
          <p class="practice__lead">
            DEFEX Engineering is a Sydney remedial consulting practice led by Andrew Fisher —
            BEng(Civil), MIEAust, CPEng, a NSW Registered Professional Engineer and NSW Registered Design
            Practitioner.
          </p>
        </Reveal>
        <Reveal delay={160}>
          <p class="practice__body">
            The practice is built on a simple structural choice:
            <strong>the engineer who inspects the building is the engineer who writes the report</strong>,
            prepares the design and superintends the works. Nothing is handed down a chain, and
            accountability never blurs.
          </p>
        </Reveal>
        <Reveal delay={240}>
          <p class="practice__body">
            That model is made viable by <a href="/defex-app">DEFEX, the in-house platform</a> that
            carries every engagement from site capture to issued document — so a small practice can
            deliver documentation with the speed and consistency of a much larger one, without diluting
            who stands behind it.
          </p>
        </Reveal>
      </div>
      <Reveal delay={200} class="practice__aside">
        <div class="practice__quote">
          <span class="practice__quote-rule"></span>
          <p class="practice__quote-text">The engineer you meet is the engineer who signs.</p>
        </div>
        <CredentialChip icon="award" label={site.principal.credentials} />
        <CredentialChip icon="shield-check" label={site.principal.registrations[0]} />
        <CredentialChip icon="pencil-ruler" label={site.principal.registrations[1]} />
      </Reveal>
    </div>
  </section>

  <!-- People -->
  <section class="people has-border" id="people">
    <div class="people__inner">
      <Reveal><Eyebrow>PEOPLE</Eyebrow></Reveal>
      <Reveal delay={60}><h2 class="people__heading">The engineer</h2></Reveal>
      <div class="people__grid">
        <div class="people__portrait" data-reveal data-delay="100" role="img" aria-label="Portrait of Andrew Fisher — placeholder, real photograph to follow">
          <span class="people__portrait-initials">AF</span>
        </div>
        <div>
          <h3 class="people__name" data-reveal data-delay="120">{site.principal.name}</h3>
          <p class="people__title" data-reveal data-delay="140">{site.principal.titleLine}</p>
          <p class="people__bio" data-reveal data-delay="160">
            Andrew is a practising remedial engineer, a NSW Registered Professional Engineer and a NSW
            Registered Design Practitioner. He leads every DEFEX engagement personally — the inspection,
            the report, the design and the superintendence.
          </p>
          <p class="people__bio" data-reveal data-delay="200">
            He also builds DEFEX, the platform the practice runs on — an engineer's answer to the gap
            between what is seen on site and what ends up in the issued document.
          </p>
          <div class="people__actions" data-reveal data-delay="240">
            <a href={site.social.linkedin} target="_blank" rel="noopener" class="people__linkedin">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
              Connect on LinkedIn
            </a>
            <a href={`mailto:${site.email}`} class="people__email">
              <Icon name="mail" size={16} /> Email Andrew
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process has-border" id="process">
    <div class="process__inner">
      <Reveal><Eyebrow>PROCESS</Eyebrow></Reveal>
      <Reveal delay={80}><h2 class="process__heading">How engagements run</h2></Reveal>
      <ol class="process__ol" data-scroll-track>
        <span class="process__rail" aria-hidden="true"></span>
        <span class="process__fill" data-scroll-fill data-mode="height" data-focal="0.72" aria-hidden="true"></span>
        {
          steps.map((step, i) => (
            <li class="process__item" data-reveal data-delay={i * 80}>
              <span class="process__num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="process__title">{step.title}</h3>
                <p class="process__desc">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand heading="Talk to the engineer directly." contactLine buttonLabel="Contact DEFEX" buttonHref="/contact" />
</Base>

<style>
  .practice {
    background: #fff;
    padding: 120px var(--site-gutter);
  }
  .practice__inner {
    max-width: var(--container-site);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 96px;
    align-items: start;
  }
  .practice__eyebrow-wrap {
    margin-bottom: 40px;
  }
  .practice__lead {
    margin: 0 0 32px;
    max-width: 62ch;
    font-size: 24px;
    font-weight: 300;
    line-height: 1.55;
    color: var(--color-navy);
    text-wrap: pretty;
  }
  .practice__body {
    margin: 0 0 28px;
    max-width: 65ch;
    font-size: 18px;
    line-height: 1.75;
    color: var(--color-ink-body);
    text-wrap: pretty;
  }
  .practice__body strong {
    font-weight: 600;
    color: var(--color-navy);
  }
  .practice__body a {
    font-weight: 600;
    color: var(--color-blue);
  }
  .practice__body:last-child {
    margin-bottom: 0;
  }
  .practice__aside {
    position: sticky;
    top: 104px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .practice__quote {
    background: var(--color-navy);
    border-radius: var(--radius-frame);
    padding: 36px 32px;
  }
  .practice__quote-rule {
    display: block;
    width: 40px;
    height: 2px;
    background: var(--color-blue);
    margin-bottom: 24px;
  }
  .practice__quote-text {
    margin: 0;
    font-size: 26px;
    font-weight: 300;
    line-height: 1.4;
    color: #fff;
    text-wrap: balance;
  }

  .people {
    background: #fff;
    padding: 120px var(--site-gutter);
  }
  .people.has-border {
    border-top: 1px solid var(--color-border);
  }
  .people__inner {
    max-width: var(--container-site);
    margin: 0 auto;
  }
  .people__heading {
    margin: 0 0 56px;
    font-size: 37px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  .people__grid {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 72px;
    align-items: start;
  }
  .people__portrait {
    width: 360px;
    height: 420px;
    border-radius: var(--radius-frame);
    background: linear-gradient(155deg, var(--color-navy), #2a2a46);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .people__portrait-initials {
    font-size: 64px;
    font-weight: 300;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.35);
  }
  .people__name {
    margin: 0 0 6px;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  .people__title {
    margin: 0 0 24px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-blueprint-ink);
  }
  .people__bio {
    margin: 0 0 20px;
    max-width: 62ch;
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-ink-body);
    text-wrap: pretty;
  }
  .people__actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .people__linkedin,
  .people__email {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .people__linkedin {
    background: var(--color-blueprint);
    border: 1px solid var(--color-blueprint-border);
    color: var(--color-blue);
  }
  .people__linkedin:hover {
    background: var(--color-blue);
    color: #fff;
    border-color: var(--color-blue);
  }
  .people__email {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-ink-muted);
  }
  .people__email:hover {
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .process {
    background: var(--color-canvas);
    padding: 120px var(--site-gutter);
  }
  .process.has-border {
    border-top: 1px solid var(--color-border);
  }
  .process__inner {
    max-width: var(--container-site);
    margin: 0 auto;
  }
  .process__heading {
    margin: 0 0 64px;
    font-size: 37px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  .process__ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 64px;
    position: relative;
  }
  .process__rail {
    position: absolute;
    left: 24px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--color-border);
  }
  .process__fill {
    position: absolute;
    left: 24px;
    top: 8px;
    width: 2px;
    height: 0%;
    max-height: calc(100% - 16px);
    background: var(--color-blue);
  }
  .process__item {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 40px;
    align-items: baseline;
    padding: 44px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .process__item:last-child {
    border-bottom: none;
  }
  .process__num {
    font-size: 64px;
    font-weight: 300;
    line-height: 1;
    color: var(--color-blue);
    font-variant-numeric: tabular-nums;
  }
  .process__title {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 600;
    color: var(--color-navy);
  }
  .process__desc {
    margin: 0;
    max-width: 60ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-steel);
  }

  @media (max-width: 1100px) {
    .practice__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .practice__aside {
      position: static;
    }
    .people__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .people__portrait {
      width: 240px;
      height: 280px;
    }
  }
  @media (max-width: 899px) {
    .practice,
    .people,
    .process {
      padding: 64px var(--site-gutter);
    }
    .process__ol {
      padding-left: 0;
    }
    .process__rail,
    .process__fill {
      display: none;
    }
    .process__item {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 20px;
    }
  }
</style>
