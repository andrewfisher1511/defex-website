# =====================================================================
# STAGING — Supabase project `defex-staging`
#
# Vercel: set these on the **Preview** and **Development** environments.
# Every branch/PR preview therefore runs against staging, never prod.
#
# Launch Pack D2 rule: "if you're about to run SQL you haven't run before,
# run it on staging first."
# =====================================================================

NEXT_PUBLIC_SUPABASE_URL="https://<defex-staging-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<defex-staging-anon-key>"

# Leave unset on Vercel Preview so each deployment uses its own generated
# origin. Set it only where the origin is fixed.
NEXT_PUBLIC_SITE_URL=""

NEXT_PUBLIC_WORKSPACE_URL="/app"
SITE_PUBLIC="false"

# ---------------------------------------------------------------------
# Matching dashboard configuration for the STAGING Google OAuth client
# ("DEFEX staging" — Launch Pack D2: two clients, one per environment).
# Configured in the consoles, not here.
#
# Google Cloud -> Credentials -> OAuth client "DEFEX staging":
#   Authorised JavaScript origins:
#     http://localhost:3000
#     https://<preview>.vercel.app        (your Vercel preview origin)
#   Authorised redirect URI:
#     https://<defex-staging-ref>.supabase.co/auth/v1/callback
#
# Supabase (defex-staging) -> Authentication:
#   Providers -> Google: staging client ID + secret
#   URL Configuration -> Site URL:  http://localhost:3000
#   URL Configuration -> Additional redirect URLs:
#     http://localhost:3000/auth/callback
#     https://<preview>.vercel.app/auth/callback
#   Sign In / Up: email+password signups disabled (A2.3)
# ---------------------------------------------------------------------
