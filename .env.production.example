# Project created 23 Jul 2026, region ap-southeast-2 (Sydney).
# NOTE: this is the WEBSITE's database. It is not, and must not be
# confused with, the `defex` project (ref ebviusxdsdnstnkgphin,
# ap-northeast-1) — that one is the DEFEX app platform's production
# database and belongs to the Documents/defex repo.
NEXT_PUBLIC_SUPABASE_URL="https://ezbnjdvsexspzovlfzaq.supabase.co"
# Publishable key. Safe to commit: it grants nothing on its own and every
# table is behind RLS. Copy from Project Settings -> API if it is rotated.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_XjanHTN2A00-5uWXXoxIoA_DAwRqhfx"

NEXT_PUBLIC_SITE_URL="https://defex.engineering"
NEXT_PUBLIC_WORKSPACE_URL="https://app.defex.engineering"

# Private preview. Flip to "true" only when the site goes public — that is
# the switch that opens `/` and `/dbp-act` to everyone. `/app/**` stays
# gated regardless.
SITE_PUBLIC="false"

# ---------------------------------------------------------------------
# Matching dashboard configuration for the PRODUCTION Google OAuth client
# ("DEFEX" — Launch Pack A1.3). Configured in the consoles, not here.
#
# Google Cloud -> OAuth consent screen (A1.2):
#   User type: External · App name: DEFEX
#   Support email: andrew@defex.engineering
#   App domain:      https://defex.engineering
#   Privacy policy:  https://defex.engineering/privacy
#   Terms:           https://defex.engineering/terms
#     ^ both routes are public in the access proxy precisely so this
#       screen and Google's reviewers can reach them.
#   Authorised domain: defex.engineering
#   Scopes: email, profile, openid only (non-sensitive, no Google review)
#
# Google Cloud -> Credentials -> OAuth client "DEFEX":
#   Authorised JavaScript origins: https://defex.engineering
#   Authorised redirect URI:
#     https://ezbnjdvsexspzovlfzaq.supabase.co/auth/v1/callback
#
# Supabase (defex-prod) -> Authentication:
#   Providers -> Google: production client ID + secret
#   URL Configuration -> Site URL: https://defex.engineering
#   URL Configuration -> Additional redirect URLs:
#     https://defex.engineering/auth/callback
#   Sign In / Up: email+password signups disabled (A2.3)
#   SMTP: Resend, sender "DEFEX <sign-in@defex.engineering>" (D1.2)
#
# Do NOT add localhost or preview origins to the production client or to
# defex-prod's redirect URLs — that is what the staging pair is for.
