# =====================================================================
# DEFEX website — environment template
#
# Local development: copy to `.env.local` and fill in the **defex-staging**
# values. Launch Pack D2: "Day-to-day you only use prod. Staging exists for
# one thing: testing schema/auth changes before they touch real client data."
# Local and preview builds point at staging so a bad migration or a broken
# auth change can never touch live client data.
#
# See .env.staging.example and .env.production.example for the two deployed
# environments and the Vercel mapping.
#
# Nothing secret belongs in this file or in any NEXT_PUBLIC_ variable.
# =====================================================================

# --- Supabase (project: defex-staging) -------------------------------
# Supabase dashboard -> Project Settings -> API
#   URL      -> Project URL
#   ANON KEY -> Project API keys -> `anon` / `public` (newer projects label
#              this the publishable key). Safe to expose: it grants nothing
#              on its own, every table is behind RLS (migration Part A3).
NEXT_PUBLIC_SUPABASE_URL="https://<staging-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<staging-anon-key>"

# --- Site ------------------------------------------------------------
# Origin used to build the OAuth redirectTo. Must appear in Supabase ->
# Authentication -> URL Configuration (Launch Pack A2.2) or the redirect is
# refused. Leave unset locally to fall back to window.location.origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Where an admitted user goes from the gate (Launch Pack A5).
NEXT_PUBLIC_WORKSPACE_URL="/app"

# --- Launch ----------------------------------------------------------
# Private preview while false: `/` shows the gate and the main site and
# `/dbp-act` are admitted-only. Set to "true" at public launch. Server-side
# only — deliberately not NEXT_PUBLIC_. `/app/**` stays gated either way.
SITE_PUBLIC="false"

# --- Email (Launch Pack D1) -------------------------------------------
# Resend dashboard -> API Keys. Server-only — never NEXT_PUBLIC_, this key
# can send mail as enquiries@defex.engineering.
#
# Leave unset for local/staging dev: every send function in src/lib/resend
# falls back to logging the email instead of dispatching it, so the DB
# writes and route logic are fully testable before D1.1 (domain + DKIM/
# SPF/DMARC verification, a manual Resend dashboard step) is done.
#
# The sender addresses themselves (enquiries@, sign-in@) are fixed by
# Launch Pack D1 and hardcoded in src/lib/resend/client.ts, not env vars —
# there is exactly one real domain, so there is nothing to switch on.
RESEND_API_KEY=""

# =====================================================================
# NOT set here, on purpose:
#
#   SUPABASE_SERVICE_ROLE_KEY
#     Bypasses RLS completely. This app never needs it — role changes are
#     run by hand in the SQL editor (Launch Pack A4) and the signup trigger
#     is SECURITY DEFINER. Do not add it.
#
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#     Not app config. They are pasted into Supabase -> Authentication ->
#     Providers -> Google (Launch Pack A2.1); the OAuth exchange happens
#     between Supabase and Google, so this app never sees them.
# =====================================================================
